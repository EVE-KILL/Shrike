# EVE-KILL — Go binary configuration.
#
# Copy to .env and fill in. In the cluster these come from the pod environment
# instead, so .env is a local-development convenience only.
#
# Variable names match the existing Bun services exactly (see
# backend/src/database/redis.ts and api/src/db.ts) — the Go binary is meant to
# be a drop-in for those pods, so nothing new is introduced here.

# Postgres. Point this at pgbouncer, not the direct instance.
#
# pgx defaults to caching prepared statements per connection, which is safe
# under session pooling but breaks under transaction pooling. If pool_mode is
# transaction, set pgx's default_query_exec_mode=exec. Keep pgx's own pool
# small regardless: the bouncer is the real connection cap.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/evekill

# Queue Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Cache Redis. Both default to the queue values above when unset, matching
# getCacheRedis(); set them only when the cache is a separate instance.
# REDIS_CACHE_HOST=
# REDIS_CACHE_PORT=

MEMGRAPH_URL=bolt://127.0.0.1:7687

# HTTP listener for `evekill serve`.
PORT=4001

# Hostnames the embedded ingress routes to dedicated surfaces, comma-separated.
# Each defaults to the production name alone; the .localhost aliases below are
# a development convenience. *.localhost resolves to loopback with no
# /etc/hosts entry, so http://api.localhost:4001 works on a fresh checkout —
# and with `serve --port 80`, http://api.localhost does too.
#
# Set one to empty (PUBLIC_API_HOST=) to stop serving that surface entirely.
# Unlike the scalar variables above, an empty list variable means the empty
# list rather than "use the default".
PUBLIC_API_HOST=api.eve-kill.com,api.localhost
WS_HOST=ws.eve-kill.com,ws.localhost
IMAGES_HOST=images.eve-kill.com,images.localhost

# The Nitro renderer's Unix socket. Every request matching no surface above is
# proxied here, which is what makes tenant custom domains work without being
# enumerated. Unset means unmatched requests get a 404 instead of a 502 from a
# renderer that is not running yet.
# NUXT_SOCKET=/tmp/shrike-nuxt.sock

# Where the ingress keeps its own state. Certificates, once Shrike terminates
# TLS itself rather than sitting behind Cloudflare.
DATA_DIR=./data

NODE_ENV=development

# LOG_LEVEL: trace|debug|info|warn|error. LOG_FORMAT: console|json.
LOG_LEVEL=info
LOG_FORMAT=console
