# EVE-KILL — Go binary configuration.
#
# Copy to .env and fill in. In the cluster these come from the pod environment
# instead, so .env is a local-development convenience only.
#
# Postgres. Point this at pgbouncer, not the direct instance.
#
# pgx defaults to caching prepared statements per connection, which is safe
# under session pooling but breaks under transaction pooling. If pool_mode is
# transaction, set pgx's default_query_exec_mode=exec. Keep pgx's own pool
# small regardless: the bouncer is the real connection cap.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/evekill
# Optional read-only endpoint. When unset it falls back to DATABASE_URL, so a
# deployment can adopt the dual-pool application before Postgres has replicas.
# Use a database role that cannot write. With CloudNativePG, the `-r` service
# reaches every instance while `-ro` reaches replicas only.
# DATABASE_READ_URL=postgresql://reader:password@127.0.0.1:5432/evekill
# DB_MAX_CONNS=10
# DB_READ_MAX_CONNS=10

# Shared Valkey for L2 caches, coordination, and pub/sub. River uses Postgres.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

MEMGRAPH_URL=bolt://127.0.0.1:7687

# EVE SSO used by the same-origin account and administration API.
# EVE_CLIENT_ID=
# EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL=https://eve-kill.com/auth/eve/callback
# ESI_USER_AGENT=EVE-KILL/your-version admin@example.com

# Optional services used by comments and GIF search. The legacy NUXT_ aliases
# are also accepted while migrating an existing frontend environment.
# OPENAI_API_KEY=
# KLIPY_API_KEY=

# Backblaze B2 through its S3-compatible endpoint. Credentials are shared, but
# custom-domain uploads and the image server may use the same bucket with
# separate key prefixes, as evekill-media does today. Either bucket may be
# omitted locally; partial endpoint/credential configuration is an error.
# B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2_MEDIA_BUCKET=evekill-media
# B2_IMAGES_BUCKET=evekill-media
# B2_KEY_ID=
# B2_APP_KEY=

# Encoded image responses retained by `shrike serve` only. This is a byte
# ceiling, not preallocated memory. Set 0 to disable the local LRU.
# IMAGE_CACHE_BYTES=1073741824

# API responses retained in the process-local L1. Valkey is the shared L2.
# This is a byte ceiling, not preallocated memory. Set 0 to disable L1.
# API_CACHE_BYTES=268435456

# HTTP listener for shrike serve and dev.
PORT=4000

# Where the ingress keeps its own state. In development this includes Caddy's
# local CA and localhost certificates; production TLS terminates at Cloudflare.
DATA_DIR=./data

NODE_ENV=development

# LOG_LEVEL: trace|debug|info|warn|error. LOG_FORMAT: console|json.
LOG_LEVEL=info
LOG_FORMAT=console

# Optional Sentry: errors, structured logs, metrics and distributed traces.
# Leave DSN empty to disable. Sampling affects traces / info logs, never errors.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOGS=true
SENTRY_LOG_LEVEL=info
SENTRY_LOG_SAMPLE_RATE=1
SENTRY_METRICS=true

# Native fitting worker (built by make build-dogma; overrides usually unnecessary).
# DOGMA_WORKER_PATH=bin/shrike-dogma
# DOGMA_SDE_DIR=frontend/dogma/dist/upstream/data/dist
DOGMA_WORKER_PROCESSES=4
