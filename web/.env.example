# Private loopback origin used only by Nuxt SSR and renderer-owned routes.
# Browser requests always stay relative on /api, /auth, /images, and /ws.
NUXT_API_ORIGIN=http://127.0.0.1:4000

# Optional local override for the separately deployed MCP service.
NUXT_PUBLIC_PUBLIC_MCP_URL=https://mcp.eve-kill.com
