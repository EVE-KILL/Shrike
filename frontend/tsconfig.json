{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "#shared/*": [
        "./shared/*"
      ],
      "@evekill/dogma": [
        "./dogma/src/index.ts"
      ]
    },
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "dogma/src/**/*.ts",
    "dogma/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
