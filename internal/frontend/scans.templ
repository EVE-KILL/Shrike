package frontend

import "strconv"

// Retained for the already validated Roam Report header.
templ scanHeader(title, eyebrow, description, symbol string) {
	<header class="page-header hero-surface glass-panel scan-header">
		<span class="page-header-icon">
			@icon(symbol)
		</span>
		<div><p class="eyebrow">{ eyebrow }</p><h1>{ title }</h1><p>{ description }</p></div>
	</header>
}

// Markup and utilities ported from the two tools pages and result components.
templ scanInputPage(kind string) {
	<div class="go-utility-page scans-page" data-scan-kind={ kind } data-controller="scans" data-action="paste@document->scans#pasteEvent focus@window->scans#identity pagehide@window->scans#hide pageshow@window->scans#show">
		if kind=="dscan" {
			@utilityPageHeader("D-Scan Analyzer", "Directional scan intelligence", "radar", "Paste a directional scan from EVE Online to identify and summarize the ships, structures, drones, and other objects around you.")
		} else {
			@utilityPageHeader("Local Scan", "Local intelligence", "scan-line", "Paste the character list from local chat to identify pilots, corporations, alliances, and potential threats.")
		}
		<div class="glass-panel p-6 mb-4">
			<p class="text-sm text-gray-500 mb-4">{ scanInputInstruction(kind) }</p>
			<div class="rounded-lg p-8 text-center">
				<p class="text-gray-400 text-sm mb-2">Press <kbd class="px-1.5 py-0.5 text-xs bg-white/[0.08] rounded font-mono text-gray-300">Ctrl+V</kbd> anywhere on this page</p>
				<p class="text-xs text-gray-600 mb-4">or use the button below</p>
				<button type="button" data-scan-paste data-action="click->scans#paste" class="px-4 py-2 bg-blue-500/20 hover:bg-blue-500/30 text-blue-400 text-sm rounded border border-blue-500/20 transition-colors disabled:opacity-50">
					<span data-scan-paste-idle class="mr-1.5 inline-block">
						@icon("clipboard-paste")
					</span>
					<span data-scan-paste-spinner hidden class="animate-spin mr-1.5 inline-block">
						@icon("loader-2")
					</span><span data-scan-paste-label>Paste from Clipboard</span>
				</button>
			</div>
			<div data-scan-error role="alert" hidden class="mt-4 p-3 rounded bg-red-500/10 border border-red-500/20 text-red-400 text-sm"></div>
		</div>
		<div data-scan-actions hidden class="mb-4 flex items-center justify-end gap-3">
			<button type="button" data-scan-save data-action="click->scans#save" hidden class="px-3 py-1.5 bg-blue-500/20 hover:bg-blue-500/30 text-blue-400 text-xs rounded border border-blue-500/20 transition-colors disabled:opacity-50">
				<span data-scan-save-idle class="mr-1 inline-block">
					@icon("share-2")
				</span>
				<span data-scan-save-spinner hidden class="animate-spin mr-1 inline-block">
					@icon("loader-2")
				</span><span data-scan-save-label>Save &amp; Share</span>
			</button>
			<span data-scan-login-hint class="text-xs text-gray-600"><button type="button" data-scan-login data-action="click->scans#login" class="text-blue-400/60 hover:text-blue-400 hover:underline cursor-pointer">Log in</button> to save and share scans</span>
		</div>
		<div data-scan-results data-action="click->scans#resultClick"></div>
	</div>
}

templ scanSavedPage(kind string, view scanResultView) {
	<div class="go-utility-page scans-page">
		<div class="flex items-center justify-between mb-4">
			<h1 class="text-xl font-bold text-white">{ scanSavedTitle(kind) }</h1><a href={ "/tools/" + kind } class="text-xs text-blue-400/60 hover:text-blue-400 hover:underline">New Scan</a>
		</div>
		@scanResults(view)
	</div>
}

templ scanResults(view scanResultView) {
	<div class="space-y-4" data-scan-result-content>
		if view.Dscan!=nil {
			@dscanResults(*view.Dscan)
		}
		if view.Local!=nil {
			@localScanResults(*view.Local)
		}
	</div>
}

templ dscanResults(view dscanView) {
	<div class="glass-panel p-3"><div class="flex items-center justify-between"><div class="text-fine font-bold uppercase tracking-[0.15em] text-blue-400/80">Scan Results</div><div class="flex gap-4"><span class="text-xs text-gray-500"><span class="text-gray-300 tabular-nums">{ strconv.FormatInt(view.TotalCount,10) }</span> objects</span><span class="text-xs text-gray-500"><span class="text-gray-300 tabular-nums">{ strconv.Itoa(view.UniqueTypes) }</span> types</span></div></div></div>
	for _,category:=range view.Categories {
		<section class="glass-panel overflow-hidden">
			<div class="px-3 py-2 border-b border-white/[0.08] flex items-center justify-between"><span class="text-fine font-bold uppercase tracking-[0.15em] text-blue-400/80">{ category.Name }</span><span class="text-xs text-gray-500 tabular-nums">{ strconv.FormatInt(category.Count,10) }</span></div>
			<div class="divide-y divide-white/[0.04]">
				for _,group:=range category.Groups {
					<details open data-scan-group={ group.Key }>
						<summary class="w-full px-3 py-2 flex items-center justify-between hover:bg-blue-500/[0.04] transition-colors cursor-pointer">
							<div class="flex items-center gap-2">
								<span class="text-gray-600 text-xs" data-scan-chevron>
									@icon("chevron-down")
								</span><span class="text-xs text-gray-300">{ group.Name }</span>
							</div><span class="text-xs text-gray-600 tabular-nums">{ strconv.FormatInt(group.Count,10) }</span>
						</summary>
						for _,item:=range group.Types {
							<div class="px-3 py-1 pl-9 flex items-center justify-between text-xs hover:bg-blue-500/[0.04] transition-colors">
								<div class="flex items-center gap-2">
									if item.TypeID!=nil && *item.TypeID>0 {
										<img src={ scanTypeImage(*item.TypeID) } alt={ item.TypeName } width="20" height="20" class="w-5 h-5 rounded" loading="lazy"/>
									}
									<span class="text-gray-500">{ item.TypeName }</span>
								</div><span class="text-gray-600 tabular-nums">{ strconv.FormatInt(item.Count,10) }</span>
							</div>
						}
					</details>
				}
			</div>
		</section>
	}
}

templ localScanResults(view localScanView) {
	if len(view.Threats)>0 {
		<section class="rounded-lg bg-white/[0.04] border border-red-500/20 overflow-hidden">
			<div class="px-3 py-2 border-b border-white/[0.08] flex items-center gap-2">
				<span class="text-red-400 text-sm">
					@icon("shield-alert")
				</span><span class="text-fine font-bold uppercase tracking-[0.15em] text-red-400/80">Potential Threats</span><span class="text-fine text-red-400/60 ml-auto tabular-nums">{ strconv.Itoa(len(view.Threats)) }</span>
			</div>
			<div class="divide-y divide-white/[0.04] max-h-80 overflow-y-auto">
				for _,threat:=range view.Threats {
					<div class="px-3 py-1.5 flex items-center justify-between hover:bg-blue-500/[0.04] transition-colors">
						<div class="flex items-center gap-2">
							<img src={ eveEntityImage("character", threat.CharacterID, 64) } alt={ threat.Name } width="24" height="24" class="w-6 h-6 rounded" loading="lazy"/>
							<div>
								<a href={ idPath("character", threat.CharacterID) } class="text-xs text-gray-300 hover:text-blue-400 hover:underline">{ threat.Name }</a>
								<div class="text-fine text-gray-600">
									{ threat.Corporation }
									if threat.Alliance!="" {
										<span>· { threat.Alliance }</span>
									}
								</div>
							</div>
						</div><span class="text-xs text-red-400/80 tabular-nums">{ strconv.FormatInt(threat.Kills,10) }/wk</span>
					</div>
				}
			</div>
		</section>
	}
	<section class="glass-panel p-3">
		<div class="px-1 pb-2 mb-2 text-fine font-bold uppercase tracking-[0.15em] text-blue-400/80 border-b border-white/[0.08]">Breakdown</div>
		<div class="grid grid-cols-3 gap-2">
			for _,stat:=range []struct{Value int;Label string}{{len(view.Alliances),"Alliances"},{view.TotalCorps,"Corporations"},{view.TotalCharacters,"Characters"}} {
				<div class="rounded bg-white/[0.04] p-2.5 text-center"><div class="text-base font-semibold text-white tabular-nums">{ strconv.Itoa(stat.Value) }</div><div class="text-fine text-gray-600 uppercase tracking-wide">{ stat.Label }</div></div>
			}
		</div>
	</section>
	for _,alliance:=range view.Alliances {
		<details class="glass-panel overflow-hidden" data-scan-alliance={ strconv.FormatInt(alliance.ID, 10) }>
			<summary class="w-full px-3 py-2.5 flex items-center justify-between hover:bg-blue-500/[0.04] transition-colors cursor-pointer">
				<div class="flex items-center gap-2">
					<img src={ eveEntityImage("alliance", alliance.ID, 64) } alt={ alliance.Name } width="24" height="24" class="w-6 h-6 rounded" loading="lazy"/>
					<span class="text-gray-600 text-xs" data-scan-chevron>
						@icon("chevron-down")
					</span><a href={ idPath("alliance", alliance.ID) } class="text-sm text-gray-300 hover:text-blue-400 hover:underline">{ alliance.Name }</a><span class="text-xs text-gray-600">[{ alliance.Ticker }]</span>
				</div>
				<div class="flex items-center gap-3"><span class="text-fine text-gray-600">{ strconv.Itoa(len(alliance.Corps)) } corps</span><span class="text-xs text-gray-500 tabular-nums">{ strconv.Itoa(alliance.People) }</span></div>
			</summary>
			<div class="border-t border-white/[0.06]">
				for _,corp:=range alliance.Corps {
					@localScanCorp(corp, true)
				}
			</div>
		</details>
	}
	if len(view.Corporations)>0 {
		<section class="rounded-lg bg-white/[0.04] border-0 overflow-hidden">
			<div class="px-3 py-2 border-b border-white/[0.08] flex items-center gap-2">
				<span class="text-yellow-500/60 text-sm">
					@icon("users")
				</span><span class="text-fine font-bold uppercase tracking-[0.15em] text-yellow-500/60">Without Alliance</span><span class="text-fine text-yellow-500/40 ml-auto tabular-nums">{ strconv.Itoa(unaffiliatedCount(view.Corporations)) }</span>
			</div>
			for _,corp:=range view.Corporations {
				@localScanCorp(corp, false)
			}
		</section>
	}
	if len(view.Unresolved)>0 {
		<div class="glass-panel p-3"><p class="text-xs text-gray-600">{ strconv.Itoa(len(view.Unresolved)) } { killBoolClass(len(view.Unresolved)>1,"names","name") } not found: <span class="text-gray-500">{ unresolvedNames(view.Unresolved) }</span></p></div>
	}
}

templ localScanCorp(corp localCorpView, nested bool) {
	<details class="border-b border-white/[0.04] last:border-b-0" data-scan-corporation={ strconv.FormatInt(corp.ID, 10) }>
		<summary class={ "w-full px-3 py-2 flex items-center justify-between hover:bg-blue-500/[0.04] transition-colors cursor-pointer " + killBoolClass(nested, "pl-8", "") }>
			<div class="flex items-center gap-2">
				<img src={ eveEntityImage("corporation", corp.ID, 64) } alt={ corp.Name } width="20" height="20" class="w-5 h-5 rounded" loading="lazy"/>
				<span class="text-gray-600 text-xs" data-scan-chevron>
					@icon("chevron-down")
				</span><a href={ idPath("corporation", corp.ID) } class="text-xs text-gray-400 hover:text-blue-400 hover:underline">{ corp.Name }</a><span class="text-fine text-gray-700">[{ corp.Ticker }]</span>
			</div><span class="text-xs text-gray-600 tabular-nums">{ strconv.Itoa(len(corp.People)) }</span>
		</summary>
		for _,person:=range corp.People {
			<div class={ "px-3 py-1 flex items-center justify-between text-xs hover:bg-blue-500/[0.04] transition-colors " + killBoolClass(nested, "pl-14", "pl-10") }>
				<a href={ idPath("character", person.CharacterID) } class="text-gray-500 hover:text-blue-400 hover:underline">{ person.Name }</a>
				if person.Kills>0 {
					<span class={ "text-xs tabular-nums " + killBoolClass(person.Kills > 5, "text-red-400/80", "text-gray-700") }>{ strconv.FormatInt(person.Kills,10) }</span>
				}
			</div>
		}
	</details>
}
