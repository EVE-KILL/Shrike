package frontend

import "strconv"

templ trackersPageContent(view trackersView) {
	<div class="go-utility-page" data-trackers-page data-controller="trackers" data-action="click->trackers#click search-pick->trackers#pick" data-trackers-seed={ settingsJSON(view.Trackers) }>
		@utilityPageHeader("Entity Trackers", "Your watchlist", "radar", "Record new killmail activity for entities and locations. Alerts are a separate, optional choice for each tracker.") {
			if view.User!=nil {
				<div class="flex flex-wrap items-center gap-2">
					<a href="/tracker" class="inline-flex items-center gap-2 rounded-md border border-blue-400/20 bg-blue-500/10 px-3 py-2 text-xs font-semibold text-blue-300 hover:bg-blue-500/20">
						@icon("scan-eye")
						Tracker
					</a>
					<button type="button" data-tracker-browser-alerts class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-xs font-semibold transition-colors border-white/10 bg-white/[0.04] text-gray-300 hover:border-blue-400/30 hover:text-blue-300">
						@icon("bell")
						<span>Browser alerts while open</span>
					</button>
				</div>
			}
		}
		if view.User==nil {
			@utilityLoginGate("Log in to create and manage entity trackers.")
		} else {
			<div class="mb-4 rounded-lg border border-blue-400/15 bg-blue-500/[0.05] px-4 py-3 text-xs text-gray-400">
				<div class="flex items-start gap-2">
					<span class="mt-0.5 flex-shrink-0 text-blue-400">
						@icon("shield-check")
					</span>
					<p>Browser alerts use this page's live connection only. They can appear while EVE-KILL is open in a tab, but there is no push subscription and nothing is delivered after the site is closed. <span hidden data-tracker-browser-denied class="text-amber-300">Notifications are currently blocked by your browser.</span></p>
				</div>
			</div>
			<div hidden?={ !view.Error } data-trackers-error role="alert" class="mb-4 rounded-lg border border-red-400/20 bg-red-500/[0.08] px-4 py-3 text-sm text-red-300"><span data-trackers-error-message>Could not load trackers.</span> <button type="button" data-trackers-retry class="ml-2 text-xs text-blue-400 hover:text-blue-300">Retry</button></div>
			<div class="grid gap-5 lg:grid-cols-[300px_minmax(0,1fr)]">
				<aside class="space-y-3">
					<div class="glass-panel p-3">
						<div class="mb-2 flex items-center justify-between"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">Add a tracker</div><span data-trackers-count class="text-fine tabular-nums text-gray-600">{ strconv.Itoa(len(view.Trackers)) }/{ strconv.Itoa(view.Limit) }</span></div>
						@searchPicker("tracker", "Search entities or locations", []string{"alliance", "corporation", "character", "region", "constellation", "system"}, searchPickerOptions{Placeholder: "Search entities or locations..."})
						<p class="mt-2 text-fine leading-relaxed text-gray-600">Tracking starts now. Historical killmails are not backfilled.</p>
					</div>
					<div class="glass-panel overflow-hidden" data-trackers-list>
						if len(view.Trackers)==0 {
							@trackersEmpty()
						} else {
							for i,tracker:=range view.Trackers {
								@trackerListEntry(tracker, i == 0)
							}
						}
					</div>
				</aside>
				<div class="min-w-0 space-y-4" data-tracker-content hidden?={ len(view.Trackers)==0 }>
					<div data-tracker-detail>
						if len(view.Trackers)>0 {
							@trackerDetail(view.Trackers[0])
						}
					</div>
					<div data-private-killfeed>
						<div class="glass-panel p-8 text-center text-sm text-gray-500">
							<span class="animate-spin mr-1">
								@icon("loader-2")
							</span>Loading kills…
						</div>
					</div>
				</div>
			</div>
		}
		<template data-tracker-empty-template>
			@trackersEmpty()
		</template>
		<template data-tracker-entry-template>
			@trackerListEntry(entityTracker{}, false)
		</template>
		<template data-tracker-detail-template>
			@trackerDetail(entityTracker{})
		</template>
	</div>
}

templ trackersEmpty() {
	<div class="px-4 py-10 text-center">
		<span class="mb-2 inline-block text-3xl text-gray-700">
			@icon("radar")
		</span>
		<p class="text-sm text-gray-400">No trackers yet</p>
		<p class="mt-1 text-xs text-gray-600">Search above to start a watchlist.</p>
	</div>
}

templ trackerAvatar(tracker entityTracker, large bool) {
	<img hidden?={ trackerPicture(tracker)=="" } data-tracker-image src={ trackerPicture(tracker) } alt={ tracker.Name } width={ killBoolClass(large, "56", "40") } height={ killBoolClass(large, "56", "40") } class={ killBoolClass(large, "h-14 w-14 flex-shrink-0 rounded-lg ring-1 ring-white/10", "h-10 w-10 flex-shrink-0 rounded-md ring-1 ring-white/10") }/>
	<span hidden?={ trackerPicture(tracker)!="" } data-tracker-symbol class={ killBoolClass(large, "flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-white/[0.05] text-xl text-gray-500", "flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-white/[0.05] text-gray-500") }>
		@icon(trackerIcon(tracker.Type))
	</span>
}

templ trackerListEntry(tracker entityTracker, selected bool) {
	<button type="button" data-tracker-select={ strconv.FormatInt(tracker.ID, 10) } class={ "relative flex w-full items-center gap-3 border-b border-white/[0.05] px-3 py-3 text-left transition-colors last:border-0 hover:bg-blue-500/[0.05]",templ.KV("bg-blue-500/[0.08]",selected) } aria-pressed={ strconv.FormatBool(selected) }>
		@trackerAvatar(tracker, false)
		<span class="min-w-0 flex-1">
			<span data-tracker-name class={ "block truncate text-sm font-semibold",templ.KV("text-gray-200",tracker.Enabled),templ.KV("text-gray-500",!tracker.Enabled) }>{ tracker.Name }</span>
			<span class="mt-0.5 flex items-center gap-2 text-fine capitalize text-gray-600">
				<span data-tracker-type>{ tracker.Type }</span>
				<span hidden?={ tracker.Ticker==nil } data-tracker-ticker class="font-mono">
					if tracker.Ticker!=nil {
						{ "["+*tracker.Ticker+"]" }
					}
				</span>
				<span hidden?={ !tracker.Notifications } data-tracker-notification-icon title="Notifications enabled" class="text-amber-400">
					@icon("bell")
				</span>
			</span>
		</span>
		<span hidden?={ tracker.Unread==0 } data-tracker-unread class="rounded-full bg-red-500 px-1.5 py-0.5 text-fine font-bold text-white">{ trackerUnreadLabel(tracker.Unread) }</span>
		<span hidden?={ !selected } data-tracker-selected class="absolute inset-y-2 left-0 w-0.5 rounded-full bg-blue-400"></span>
	</button>
}

templ trackerDetail(tracker entityTracker) {
	<div class="glass-panel p-4">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
			<div class="flex min-w-0 items-center gap-3">
				@trackerAvatar(tracker, true)
				<div class="min-w-0"><a data-tracker-profile href={ templ.URL("/" + tracker.Type + "/" + strconv.FormatInt(tracker.TargetID, 10)) } class="truncate text-lg font-bold text-white hover:text-blue-300">{ tracker.Name }</a><div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500"><span data-tracker-type class="capitalize">{ tracker.Type }</span><span data-tracker-event-count>{ strconv.FormatInt(tracker.EventCount,10) } recorded kills</span><span data-tracker-last-activity></span></div></div>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-tracker-toggle="enabled" class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-xs font-semibold transition-colors">
					@icon("radio")
					<span>Tracking</span>
				</button>
				<button type="button" data-tracker-toggle="notifications_enabled" class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-xs font-semibold transition-colors">
					@icon("bell-off")
					<span>Notifications off</span>
				</button>
				<button type="button" data-tracker-delete aria-label="Delete tracker" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-red-400/15 text-red-400/70 transition-colors hover:bg-red-500/10 hover:text-red-300">
					@icon("trash-2")
				</button>
			</div>
		</div>
		<div class="mt-3 border-t border-white/[0.06] pt-3 text-xs text-gray-500" data-tracker-alert-explanation></div>
	</div>
}
