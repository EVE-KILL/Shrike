package frontend

import (
	"fmt"
	"strconv"
)

// Port of DateTimePicker.vue; values always represent an EVE/UTC wall clock.
templ dateTimePicker(options dateTimePickerOptions) {
	<div class="relative" data-date-time-picker data-controller="date-time-picker" data-action="click->date-time-picker#click change->date-time-picker#change pointerdown@document->date-time-picker#outside keydown@document->date-time-picker#keyboard pagehide@window->date-time-picker#close" data-placeholder={ options.Placeholder }>
		<input type="hidden" name={ options.Name } value={ options.Value } data-date-time-value disabled?={ options.Disabled }/>
		<button type="button" disabled?={ options.Disabled } data-date-time-trigger aria-label={ options.Placeholder } aria-expanded="false" class={ "w-full flex items-center gap-2 rounded-lg bg-white/[0.04] border text-left transition-colors disabled:opacity-40 disabled:cursor-not-allowed border-white/[0.08] hover:border-white/[0.16] cursor-pointer " + killBoolClass(options.Compact, "px-2 py-1 text-xs", "px-3 py-2 text-sm") }>
			@icon("calendar-clock")
			<span class="flex-1 min-w-0 truncate tabular-nums text-gray-200" data-date-time-label>
				if options.Value != "" {
					{ dateTimePickerLabel(options.Value) }
				} else {
					{ options.Placeholder }
				}
			</span>
			<span class="text-fine flex-shrink-0 text-blue-400/70" data-date-time-zone-label>EVE</span>
			@icon("chevron-down")
		</button>
		<div hidden data-date-time-panel class="absolute z-50 mt-1 w-[19rem] max-w-[calc(100vw-1.5rem)] rounded-lg border border-white/[0.10] bg-[#141414]/97 backdrop-blur-xl shadow-2xl shadow-black/60 p-3 left-0">
			<div class="flex items-center justify-between gap-2 mb-3">
				<span class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">Time zone</span>
				<div class="flex rounded-md border border-white/[0.08] overflow-hidden">
					<button type="button" data-date-time-zone="eve" class="px-2 py-1 text-fine font-medium transition-colors cursor-pointer" title="EVE time (UTC)">EVE</button>
					<button type="button" data-date-time-zone="local" class="px-2 py-1 text-fine font-medium transition-colors cursor-pointer">Local</button>
				</div>
			</div>
			<div class="flex items-center justify-between gap-2 mb-2">
				<button type="button" data-date-time-month="-1" aria-label="Previous month" class="w-7 h-7 rounded-md flex items-center justify-center text-gray-500 hover:text-gray-200 hover:bg-white/[0.06] transition-colors cursor-pointer">
					@icon("chevron-left")
				</button>
				<div class="text-xs font-medium text-gray-200 tabular-nums" data-date-time-month-label></div>
				<button type="button" data-date-time-month="1" aria-label="Next month" class="w-7 h-7 rounded-md flex items-center justify-center text-gray-500 hover:text-gray-200 hover:bg-white/[0.06] transition-colors cursor-pointer">
					@icon("chevron-right")
				</button>
			</div>
			<div class="grid grid-cols-7 gap-0.5 mb-1">
				for _, day := range []string{"Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"} {
					<div class="text-fine text-gray-600 text-center py-1">{ day }</div>
				}
			</div>
			<div class="grid grid-cols-7 gap-0.5" data-date-time-calendar></div>
			<div class="flex items-center gap-2 mt-3 pt-3 border-t border-white/[0.06]">
				@icon("clock")
				<select data-date-time-hour aria-label="Hour" class="flex-1 min-w-0 px-2 py-1.5 rounded-md bg-gray-900 border border-white/[0.08] text-xs text-gray-200 tabular-nums focus:border-blue-500/40 focus:outline-none cursor-pointer">
					for hour := 0; hour < 24; hour++ {
						<option value={ strconv.Itoa(hour) }>{ fmt.Sprintf("%02d", hour) }</option>
					}
				</select>
				<span class="text-gray-600">:</span>
				<select data-date-time-minute aria-label="Minute" class="flex-1 min-w-0 px-2 py-1.5 rounded-md bg-gray-900 border border-white/[0.08] text-xs text-gray-200 tabular-nums focus:border-blue-500/40 focus:outline-none cursor-pointer">
					for minute := 0; minute < 60; minute++ {
						<option value={ strconv.Itoa(minute) }>{ fmt.Sprintf("%02d", minute) }</option>
					}
				</select>
				<button type="button" data-date-time-now class="px-2 py-1.5 rounded-md text-fine font-medium text-gray-400 bg-white/[0.04] border border-white/[0.08] hover:bg-blue-500/[0.08] hover:text-blue-400 transition-colors cursor-pointer flex-shrink-0">Now</button>
			</div>
			<div class="mt-2 text-fine text-gray-600 tabular-nums" data-date-time-counterpart hidden></div>
			<div class="flex items-center justify-between gap-2 mt-3">
				if !options.HideClear {
					<button type="button" data-date-time-clear class="text-fine text-gray-500 hover:text-red-400 transition-colors cursor-pointer">Clear</button>
				} else {
					<span></span>
				}
				<button type="button" data-date-time-done class="px-3 py-1.5 rounded-md text-fine font-medium bg-blue-500 text-white hover:bg-blue-600 transition-colors cursor-pointer">Done</button>
			</div>
		</div>
	</div>
}
