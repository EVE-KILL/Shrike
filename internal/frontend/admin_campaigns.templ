package frontend

import "strconv"

templ adminCampaigns(data adminCampaignsData) {
	<div class="space-y-4" data-admin-campaigns data-controller="admin-campaigns" data-action="click->admin-campaigns#click input->admin-campaigns#search pagehide@window->admin-campaigns#hide pageshow@window->admin-campaigns#show" data-query={ settingsJSON(data.Query.values()) }>
		<div class="glass-panel p-4">
			<div class="flex flex-col md:flex-row gap-3">
				<div class="relative flex-1">
					<span class="absolute left-3 top-2.5 text-sm text-gray-600">
						@icon("search")
					</span>
					<input data-admin-campaign-search value={ data.Query.Search } aria-label="Search campaigns" class="w-full pl-9 pr-3 py-2 rounded-md bg-white/[0.04] border border-white/[0.08] text-sm text-white placeholder-gray-600 focus:outline-none focus:border-blue-500/50" placeholder="Campaign ID, name, or creator…"/>
				</div>
				<div data-admin-campaign-filter class="inline-flex"></div>
			</div>
			<p hidden data-admin-campaign-action-error class="mt-3 text-xs text-red-400" role="alert"></p>
			<p hidden?={ !data.Failed } data-admin-campaign-error class="mt-3 text-xs text-red-400" role="alert">Could not load campaigns. <button type="button" data-admin-campaign-retry class="text-blue-400">Retry</button></p>
		</div>
		<div class="space-y-4" data-admin-campaign-results>
			@adminCampaignResults(data)
		</div>
	</div>
}

templ adminCampaignResults(data adminCampaignsData) {
	<div class="space-y-4" data-admin-campaign-result data-failed={ strconv.FormatBool(data.Failed) }>
		for _,campaign:=range data.Rows {
			<div data-admin-campaign-id={ campaign.ID } class="glass-panel p-4">
				<div class="flex flex-col xl:flex-row xl:items-start gap-4">
					<div class="flex-1 min-w-0">
						<div class="flex items-center gap-2 flex-wrap">
							<a href={ "/campaign/" + campaign.ID } class="text-sm font-medium text-white hover:text-blue-400 truncate">{ campaign.Name }</a>
							{{ label, tone := campaign.status() }}
							<span class={ "px-2 py-0.5 rounded text-fine font-medium " + tone }>{ label }</span>
							<span class="text-fine text-gray-600">{ campaign.visibility() }</span>
						</div>
						<div class="mt-1 text-fine text-gray-600"><span class="font-mono">{ campaign.ID }</span><span>{ " · " }</span><a href={ "/character/" + strconv.FormatInt(campaign.CreatorID, 10) } class="hover:text-blue-400">{ campaign.creator() }</a></div>
						if campaign.Note!=nil&&*campaign.Note!="" {
							<p class="mt-2 text-xs text-red-300">{ *campaign.Note }</p>
						}
						if campaign.Error!=nil&&*campaign.Error!="" {
							<p class="mt-1 text-fine text-red-400/70 break-words">{ *campaign.Error }</p>
						}
					</div>
					<div class="grid grid-cols-3 gap-4 text-center xl:w-80">
						<div><div class="text-xs text-gray-300 tabular-nums">{ adminCampaignCount(campaign.Estimated) }</div><div class="text-fine text-gray-600">Estimated</div></div>
						<div><div class="text-xs text-gray-300 tabular-nums">{ killNumber(campaign.processed()) }</div><div class="text-fine text-gray-600">Processed</div></div>
						<div><div class="text-xs text-gray-300 tabular-nums">{ adminCampaignDuration(campaign.Duration) }</div><div class="text-fine text-gray-600">Runtime</div></div>
					</div>
					<div class="flex items-center gap-1.5 flex-wrap xl:justify-end">
						if campaign.Paused {
							<button type="button" data-admin-campaign-action="resume" class="px-2.5 py-1.5 rounded-md text-fine text-green-400 bg-green-500/10 hover:bg-green-500/20">Resume</button>
						} else {
							<button type="button" data-admin-campaign-action="pause" class="px-2.5 py-1.5 rounded-md text-fine text-yellow-400 bg-yellow-500/10 hover:bg-yellow-500/20">Pause</button>
						}
						<button type="button" data-admin-campaign-action="reprocess" class="px-2.5 py-1.5 rounded-md text-fine text-blue-400 bg-blue-500/10 hover:bg-blue-500/20">Reprocess</button>
						<button type="button" data-admin-campaign-action="archive" class="px-2.5 py-1.5 rounded-md text-fine text-gray-400 bg-white/[0.04] hover:bg-white/[0.08]">Archive</button>
						<button type="button" data-admin-campaign-action="delete" class="px-2.5 py-1.5 rounded-md text-fine bg-red-500/10 hover:bg-red-500/20 text-red-400">Delete</button>
					</div>
				</div>
			</div>
		}
		if !data.Failed&&len(data.Rows)==0 {
			<div class="glass-panel p-8 text-center text-sm text-gray-500">No campaigns match these filters.</div>
		}
		if !data.Failed&&(data.Page>1||data.HasMore) {
			<div class="flex items-center justify-center gap-2">
				<button type="button" data-admin-campaign-page={ strconv.Itoa(data.Page - 1) } class="glass-panel px-3 py-1.5 text-xs text-gray-400 disabled:opacity-30" disabled?={ data.Page<=1 }>Previous</button>
				<span class="text-fine text-gray-600">{ "Page "+strconv.Itoa(data.Page) }</span>
				<button type="button" data-admin-campaign-page={ strconv.Itoa(data.Page + 1) } class="glass-panel px-3 py-1.5 text-xs text-gray-400 disabled:opacity-30" disabled?={ !data.HasMore }>Next</button>
			</div>
		}
	</div>
}
