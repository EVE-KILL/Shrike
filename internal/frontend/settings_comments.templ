package frontend

import "time"

templ settingsMyComments(view settingsView) {
	<div class="space-y-4" data-settings-comments data-controller="settings-comments" data-action="click->settings-comments#click pagehide@window->settings-comments#hide" data-cursor={ cursorString(view.Comments.NextCursor) } data-loaded={ killBoolClass(!view.CommentsError, "true", "false") }>
		<div class="glass-panel p-5">
			<div class="flex items-center justify-between gap-3 mb-4">
				<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">My Comments</h2>
				<button type="button" data-settings-comments-refresh class="flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs text-gray-400 hover:text-white hover:bg-white/[0.06] border border-white/[0.06] transition-colors cursor-pointer">
					<span class="text-xs">
						@icon("refresh-cw")
					</span>Refresh
				</button>
			</div>
			<p class="text-xs text-gray-600 mb-4">Every comment you've posted across EVE-KILL, newest first. Deleting is permanent — the thread will show a <em>[deleted]</em> placeholder in place of your message.</p>
			<div hidden?={ !view.CommentsError } data-settings-comments-error role="alert" class="mb-3 rounded-md border border-red-500/30 bg-red-500/[0.06] p-2.5 text-xs text-red-300 flex items-center gap-2">
				<span class="text-sm flex-shrink-0">
					@icon("circle-alert")
				</span><span data-settings-comments-error-text>Could not load your comments</span>
			</div>
			<div hidden?={ view.CommentsError||len(view.Comments.Comments)>0 } data-settings-comments-empty class="rounded-md border border-white/[0.06] bg-white/[0.02] py-10 px-4 text-center">
				<div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/[0.03] border border-white/[0.06] mb-3">
					<span class="text-xl text-gray-600">
						@icon("message-circle-off")
					</span>
				</div>
				<p class="text-sm text-gray-500">You haven't posted any comments yet.</p>
			</div>
			<ul class="space-y-2.5" data-settings-comments-list>
				@settingsCommentCards(view.Comments.Comments, view.Now)
			</ul>
			<div hidden?={ len(view.Comments.Comments)==0||view.Comments.NextCursor==nil } data-settings-comments-more-wrap class="mt-4 flex justify-center">
				<button type="button" data-settings-comments-more class="flex items-center gap-2 px-4 py-2 rounded-md text-xs font-medium text-blue-300 bg-blue-500/[0.1] border border-blue-500/20 hover:bg-blue-500/[0.2] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer transition-colors">
					<span class="text-sm">
						@icon("chevron-down")
					</span><span data-settings-comments-more-label>Load more</span>
				</button>
			</div>
			<div hidden?={ len(view.Comments.Comments)==0||view.Comments.NextCursor!=nil } data-settings-comments-end class="mt-4 text-center text-xs text-gray-600">— End of list —</div>
		</div>
	</div>
}

templ settingsCommentCards(comments []settingsComment, now time.Time) {
	for _,comment:=range comments {
		{{ meta := settingsCommentMeta(comment) }}
		<li data-settings-comment={ warID(comment.ID) } class="rounded-md border border-white/[0.06] bg-white/[0.02] p-3 hover:border-white/[0.1] hover:bg-white/[0.035] transition-colors">
			<div class="flex items-center gap-2 mb-2 flex-wrap">
				<a href={ meta.Href } class={ "inline-flex items-center gap-1 px-2 py-0.5 rounded text-fine font-semibold uppercase tracking-wider hover:brightness-125 transition-all " + meta.ChipBg + " " + meta.ChipText }>
					<span class="text-xs">
						@icon(meta.Icon)
					</span>{ meta.Label }
					<span class="text-xs opacity-60">
						@icon("arrow-up-right")
					</span>
				</a>
				if comment.ParentID!=nil {
					<span class="inline-flex items-center gap-1 text-fine text-gray-500">
						<span class="text-xs">
							@icon("corner-down-right")
						</span>reply
					</span>
				}
				if comment.DomainID!=nil {
					<span title="Posted on a custom domain" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-fine text-gray-400 bg-white/[0.04] border border-white/[0.06]">
						<span class="text-xs">
							@icon("globe")
						</span>custom domain
					</span>
				}
				if comment.Moderation!=0 {
					<span title={ "Moderation status: " + warID(int64(comment.Moderation)) } class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-fine text-yellow-400 bg-yellow-500/[0.08]">
						<span class="text-xs">
							@icon("shield-alert")
						</span>{ killBoolClass(comment.Moderation==1,"pending",killBoolClass(comment.Moderation==2,"flagged","hidden")) }
					</span>
				}
				<div class="flex-1"></div>
				<span class="text-fine text-gray-600 whitespace-nowrap" title={ settingsDate(&comment.CreatedAt) }>
					{ settingsSince(&comment.CreatedAt,now) }
					if comment.EditedAt!=nil {
						<span>· edited</span>
					}
				</span>
			</div>
			<div class="comment-body text-sm text-gray-200 prose prose-invert max-w-none prose-sm line-clamp-4">
				@templ.Raw(commentSafeBody(comment.BodyHTML))
			</div>
			<div class="mt-2.5 pt-2.5 border-t border-white/[0.05] flex items-center gap-2">
				if comment.ReplyCount>0 {
					<span class="inline-flex items-center gap-1 text-xs text-gray-500">
						<span class="text-xs">
							@icon("message-square")
						</span>{ warID(int64(comment.ReplyCount)) } { killBoolClass(comment.ReplyCount==1,"reply","replies") }
					</span>
				}
				<div class="flex-1"></div>
				<button type="button" data-settings-comment-delete={ warID(comment.ID) } title="Delete comment" class="flex items-center gap-1 px-2 py-1 rounded text-xs text-gray-500 hover:text-red-400 hover:bg-red-500/[0.08] cursor-pointer transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
					<span class="text-xs">
						@icon("trash-2")
					</span><span data-settings-comment-delete-label>Delete</span>
				</button>
			</div>
		</li>
	}
}
