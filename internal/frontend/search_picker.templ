package frontend

import (
	"strconv"
	"strings"
)

templ searchPicker(name, label string, types []string, options ...searchPickerOptions) {
	<div class="relative" data-search-picker data-controller="search-picker" data-action="input->search-picker#search keydown->search-picker#keyboard click->search-picker#pick pointerdown@document->search-picker#outside" data-picker-name={ name } data-picker-types={ strings.Join(types, ",") } data-picker-location-images={ strconv.FormatBool(searchPickerConfig(options).LocationImages) } data-picker-type-images={ strconv.FormatBool(searchPickerConfig(options).TypeImages) } data-picker-limit={ strconv.Itoa(searchPickerLimit(options)) } data-picker-debounce={ strconv.Itoa(searchPickerDebounce(options)) }>
		<div class={ "glass-panel flex items-center gap-2 focus-within:border-blue-500/40 transition-colors " + killBoolClass(searchPickerConfig(options).Large, "px-3 py-2.5", "px-2.5 py-1.5") }>
			<span class={ "text-gray-500 flex-shrink-0 " + killBoolClass(searchPickerConfig(options).Large, "text-base", "text-xs") }>
				@icon("search")
			</span>
			<input type="text" data-picker-input autocomplete="off" aria-label={ label } placeholder={ searchPickerText(types, options) } class={ "flex-1 bg-transparent text-white outline-none placeholder-gray-600 disabled:opacity-40 min-w-0 " + killBoolClass(searchPickerConfig(options).Large, "text-sm", "text-xs") }/>
			<span data-picker-spinner hidden class="text-xs text-gray-500 animate-spin">
				@icon("loader-2")
			</span>
		</div>
		<div data-picker-results hidden class={ "absolute z-50 mt-1 w-full rounded-lg bg-black/90 backdrop-blur-xl border border-white/[0.08] shadow-2xl overflow-y-auto " + killBoolClass(searchPickerConfig(options).Large, "max-h-60", "max-h-80") }></div>
		<template data-picker-hit-template>
			<button type="button" class="w-full flex items-center gap-2.5 px-3 py-2.5 border-b border-white/[0.04] last:border-b-0 hover:bg-blue-500/[0.06] transition-colors text-left disabled:opacity-40 cursor-pointer">
				<img data-picker-image hidden width="28" height="28" alt="" loading="lazy" class="w-7 h-7 rounded flex-shrink-0"/>
				<div data-picker-symbol class="w-7 h-7 rounded bg-white/[0.06] flex items-center justify-center flex-shrink-0">
					<span class="text-xs text-gray-500">
						@icon("map-pin")
					</span>
				</div>
				<div class="min-w-0"><div data-picker-hit-name class="text-sm text-gray-200 truncate"></div><div hidden?={ searchPickerConfig(options).Compact } class="text-fine text-gray-500 capitalize"><span data-picker-hit-type></span><span data-picker-hit-ticker hidden class="text-gray-600 font-mono ml-1"></span></div></div>
			</button>
		</template>
	</div>
}
