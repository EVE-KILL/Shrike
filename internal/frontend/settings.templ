package frontend

import "strconv"

templ settingsPageContent(view settingsView) {
	<div class="go-utility-page settings-page w-full" data-settings-root data-controller="settings" data-action="click->settings#click popstate@window->settings#restore pagehide@window->settings#hide pageshow@window->settings#show" data-active={ view.Active } data-user-settings={ settingsJSON(settingsUserConfig(view.User)) }>
		if view.User==nil {
			@utilityLoginGate("Log in with EVE Online to access your settings")
		} else {
			<div class="hero-surface glass-panel overflow-hidden mb-6">
				<a href={ "/character/" + warID(view.User.ID) } class="block relative">
					<img src={ eveEntityImage("character", view.User.ID, 512) } alt={ view.User.Name } width="512" height="128" class="w-full h-32 object-cover object-top"/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
					<div class="absolute bottom-0 left-0 right-0 p-4 flex items-end gap-4">
						<img src={ eveEntityImage("character", view.User.ID, 128) } alt={ view.User.Name } width="64" height="64" class="w-16 h-16 rounded-full border-2 border-black/50 flex-shrink-0"/>
						<div class="flex-1 min-w-0 pb-1">
							<div class="text-lg font-bold text-white truncate">{ view.User.Name }</div>
							<div class="flex items-center gap-3 mt-0.5">
								if view.User.CorporationName!="" {
									<span class="flex items-center gap-1.5 text-xs text-gray-300"><img src={ eveEntityImage("corporation", view.User.CorporationID, 32) } alt="" width="16" height="16" class="w-4 h-4 rounded"/>{ view.User.CorporationName }</span>
								}
								if view.User.AllianceName!="" {
									<span class="flex items-center gap-1.5 text-xs text-gray-300"><img src={ eveEntityImage("alliance", view.User.AllianceID, 32) } alt="" width="16" height="16" class="w-4 h-4 rounded"/>{ view.User.AllianceName }</span>
								}
							</div>
						</div>
					</div>
				</a>
			</div>
			<div class="flex flex-col md:flex-row gap-6">
				@settingsNavigation(view)
				<div class="flex-1 min-w-0" data-settings-panels>
					@settingsSectionContent(view)
				</div>
			</div>
		}
	</div>
}

templ settingsNavigation(view settingsView) {
	<nav class="settings-nav md:w-48 flex-shrink-0" aria-label="Settings sections">
		<div class="flex md:flex-col overflow-x-auto gap-1 md:gap-0.5 pb-2 md:pb-0 scrollbar-hide">
			for _,section:=range settingsSections {
				<a href={ settingsPath(section.ID) } data-settings-tab={ section.ID } aria-current={ killBoolClass(view.Active == section.ID, "page", "false") } class={ "flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-left cursor-pointer whitespace-nowrap flex-shrink-0 " + killBoolClass(view.Active == section.ID, "bg-blue-500/10 text-blue-400", "text-gray-500 hover:text-blue-400 hover:bg-blue-500/[0.04]") }>
					<span class="text-base flex-shrink-0">
						@icon(section.Icon)
					</span><span class="flex-1 min-w-0 truncate">{ section.Label }</span>
				</a>
			}
			<div class="hidden md:block mt-4 pt-4 border-t border-white/[0.06]">
				if view.User.Admin {
					<a href="/admin" class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-500 hover:text-blue-400 hover:bg-blue-500/[0.04] transition-colors mb-0.5">
						<span class="text-base">
							@icon("shield-alert")
						</span>Admin Panel
					</a>
				}
				<button type="button" data-settings-logout class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-colors w-full text-left cursor-pointer">
					<span class="text-base">
						@icon("log-out")
					</span>Logout
				</button>
				<p hidden data-settings-logout-error role="alert" class="mt-2 text-xs text-red-400"></p>
			</div>
		</div>
	</nav>
}

templ settingsSectionContent(view settingsView) {
	<section data-settings-section={ view.Active }>
		if component:=settingsComponent(view);component!=nil {
			@component
		}
	</section>
}

templ settingsOverview(view settingsView) {
	<div class="space-y-4" data-settings-overview>
		if view.OverviewError {
			<p class="glass-panel p-4 text-sm text-red-300" role="alert">Could not load your account overview. <button type="button" data-settings-section-retry class="text-blue-400">Retry</button></p>
		}
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
			<div class="glass-panel p-4 text-center">
				<div class="text-fine uppercase tracking-wider text-gray-500 mb-1">ESI Token</div>
				{{ status, color := settingsTokenStatus(view.Overview, view.Now) }}
				<div class={ "text-base font-bold " + color }>{ status }</div>
				<div class="text-xs text-gray-500">{ strconv.Itoa(settingsScopeCount(view.Overview)) } scopes</div>
			</div>
			@settingsSummaryCard("Requests (24h)", settingsNumber(view.Overview.RawStats["requests_24h"]), settingsNumber(view.Overview.RawStats["total_requests"])+" total", "text-white")
			@settingsSummaryCard("New Items (24h)", settingsNumber(view.Overview.RawStats["new_items_24h"]), settingsNumber(view.Overview.RawStats["total_new_items"])+" total", "text-blue-400")
			@settingsSummaryCard("Errors (24h)", settingsNumber(view.Overview.RawStats["errors_24h"]), settingsNumber(view.Overview.RawStats["total_errors"])+" total", killBoolClass(settingsHasErrors(view.Overview), "text-red-400", "text-white"))
		</div>
		<div class="glass-panel p-5">
			<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-4">Account</h2>
			<div class="space-y-3">
				@settingsAccountRow("Character ID", warID(view.User.ID), "text-gray-300 tabular-nums")
				@settingsAccountRow("Owner Hash", view.User.OwnerHash, "text-gray-300 font-mono text-xs truncate ml-4 max-w-[200px]")
				@settingsAccountRow("Member Since", settingsDate(view.Overview.Account.CreatedAt), "text-gray-300 tabular-nums")
				@settingsAccountRow("Last Login", settingsSince(view.Overview.Account.LastLogin, view.Now), "text-gray-300 tabular-nums")
				@settingsAccountRow("Last ESI Fetch", settingsLastFetch(view.Overview, view.Now), "text-gray-300 tabular-nums")
				@settingsAccountRow("Admin", killBoolClass(view.User.Admin, "Yes", "No"), killBoolClass(view.User.Admin, "text-green-400", "text-gray-600"))
			</div>
		</div>
		<div class="glass-panel p-5">
			<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-4">Quick Links</h2>
			<div class="space-y-1">
				@settingsQuickLink("/character/"+warID(view.User.ID), "external-link", "View public profile")
				if view.User.CorporationID>0 {
					@settingsQuickLink("/corporation/"+warID(view.User.CorporationID), "building", view.User.CorporationName)
				}
				if view.User.AllianceID>0 {
					@settingsQuickLink("/alliance/"+warID(view.User.AllianceID), "shield", view.User.AllianceName)
				}
			</div>
		</div>
		<button type="button" data-settings-logout class="md:hidden flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-red-400 bg-red-500/10 border border-red-500/20 hover:bg-red-500/20 transition-colors cursor-pointer">
			<span class="text-base">
				@icon("log-out")
			</span>Logout
		</button>
	</div>
}

templ settingsSummaryCard(label, value, subtitle, color string) {
	<div class="glass-panel p-4 text-center"><div class="text-fine uppercase tracking-wider text-gray-500 mb-1">{ label }</div><div class={ "text-base font-bold tabular-nums " + color }>{ value }</div><div class="text-xs text-gray-500">{ subtitle }</div></div>
}

templ settingsAccountRow(label, value, class string) {
	<div class="flex justify-between text-sm"><span class="text-gray-500">{ label }</span><span class={ class }>{ value }</span></div>
}

templ settingsQuickLink(path, symbol, label string) {
	<a href={ path } class="flex items-center gap-2 px-3 py-2 -mx-3 rounded-md text-sm text-gray-400 hover:text-blue-400 hover:bg-blue-500/[0.04] transition-colors">
		<span class="text-base opacity-60">
			@icon(symbol)
		</span>{ label }
	</a>
}

templ settingsPreferences(user *settingsUser) {
	<div class="space-y-4" data-settings-preferences data-controller="settings-preferences" data-action="click->settings-preferences#click keydown->settings-preferences#keyboard pointerdown@document->settings-preferences#outside pagehide@window->settings-preferences#hide">
		<div class="glass-panel p-5">
			<div class="flex items-center justify-between mb-4"><h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">Default Page</h2><div class="flex items-center gap-2"><span hidden data-settings-prefs-saved class="text-xs text-green-400">Saved</span><button type="button" data-settings-save-prefs class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer bg-blue-500/15 text-blue-400 hover:bg-blue-500/25">Save</button></div></div>
			<p hidden data-settings-prefs-error role="alert" class="mb-4 rounded-md border border-red-500/25 bg-red-500/[0.06] px-3 py-2 text-xs text-red-300"></p>
			<p class="text-xs text-gray-600 mb-4">Choose which tab opens by default when navigating to an entity page without a specific tab. The item setting also covers ship and item-group pages.</p>
			<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
				for _,group:=range settingsData.Tabs {
					<div>
						<div class="text-xs text-gray-500 mb-1.5">{ group.Label }</div>@settingsSelectMenu(group, settingsValue(user, "defaultTabs", group.Key))
					</div>
				}
			</div>
		</div>
		<div class="glass-panel p-5">
			<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-4">Time Zone</h2>
			<p class="text-xs text-gray-600 mb-4">Which clock date and time pickers are drawn in. Saved to this browser instantly — it changes only what you see, never the instant a picker stores.</p>
			<div class="flex flex-col sm:flex-row gap-2">
				for _,zone:=range []struct{ID,Label,Hint string}{{"eve","EVE time","UTC — the clock the game and the rest of the site use"},{"local","Local time","Local"}} {
					<button type="button" data-settings-zone={ zone.ID } class={ "flex-1 min-w-0 text-left px-4 py-3 rounded-lg border transition-colors cursor-pointer " + killBoolClass(zone.ID == "eve", "bg-blue-500/10 border-blue-500/40 text-blue-300", "bg-white/[0.02] border-white/[0.08] text-gray-400 hover:border-white/[0.15] hover:bg-blue-500/[0.04]") }>
						<div class="flex items-center gap-2 text-sm font-medium">
							<span class="text-base flex-shrink-0">
								@icon(killBoolClass(zone.ID == "eve", "circle-check", "circle"))
							</span>{ zone.Label }
						</div>
						<div class="text-xs text-gray-600 mt-1 pl-6 truncate" data-settings-zone-hint>{ zone.Hint }</div>
					</button>
				}
			</div>
		</div>
	</div>
}

templ settingsSelectMenu(group settingsTabGroup, value string) {
	<div class="relative inline-flex w-full" data-settings-select={ group.Key } data-value={ value }>
		<button type="button" aria-label={ group.Label + " default page" } aria-expanded="false" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs transition-colors cursor-pointer border bg-white/[0.06] text-gray-300 border-white/[0.08] hover:border-white/[0.12] w-full justify-between">
			<span class="truncate max-w-[120px]" data-settings-select-label>{ settingsOptionLabel(group,value) }</span>
			<span class="text-[10px] opacity-60 transition-transform">
				@icon("chevron-down")
			</span>
		</button>
		<div hidden data-settings-select-options class="absolute top-full left-0 mt-1.5 z-50 rounded-xl border border-white/[0.10] bg-[#141414]/95 backdrop-blur-2xl shadow-2xl shadow-black/60 overflow-y-auto max-h-[50vh] p-1.5 min-w-[10rem]">
			for _,option:=range group.Options {
				<button type="button" data-settings-select-option={ option.Value } class={ "flex items-center w-full px-2.5 py-1.5 rounded-md text-xs transition-colors text-left cursor-pointer " + killBoolClass(value == option.Value, "text-white bg-blue-500/[0.12]", "text-gray-400 hover:text-blue-400 hover:bg-blue-500/[0.06]") }>{ option.Label }</button>
			}
		</div>
	</div>
}

templ settingsSessions() {
	<div class="space-y-5" data-settings-sessions data-controller="settings-sessions" data-action="click->settings-sessions#click pagehide@window->settings-sessions#hide pageshow@window->settings-sessions#show">
		<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
			<div><h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">Logged-in sessions</h2><p class="text-xs text-gray-500 mt-1">Each browser stays signed in independently. Revoke anything you do not recognize.</p></div>
			<button type="button" hidden data-settings-revoke-others class="px-3 py-2 rounded-lg border text-xs font-medium transition-colors cursor-pointer disabled:opacity-50 border-white/[0.08] bg-white/[0.03] text-gray-400 hover:text-red-300 hover:border-red-500/30">
				<span class="mr-1.5" data-settings-revoke-icon>
					@icon("log-out")
				</span><span data-settings-revoke-label>Log out everywhere else</span>
			</button>
		</div>
		<p hidden data-settings-sessions-error role="alert" class="rounded-lg border border-red-500/20 bg-red-500/[0.06] px-3 py-2 text-xs text-red-300"></p>
		<div data-settings-sessions-list>
			<div class="glass-panel p-8 text-center text-sm text-gray-500">
				<span class="animate-spin mr-2">
					@icon("loader-2")
				</span>Loading sessions…
			</div>
		</div>
	</div>
}
