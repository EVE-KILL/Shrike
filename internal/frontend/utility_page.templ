package frontend

// The existing PageHeader.vue structure for pages retaining Nuxt utilities.
templ utilityPageHeader(title, eyebrow, symbol, description string, descriptionContent ...templ.Component) {
	{{ view := utilityHeaderView{Title: title, Eyebrow: eyebrow, Symbol: symbol, Description: description} }}
	if len(descriptionContent)>0 {
		{{ view.DescriptionContent = descriptionContent[0] }}
	}
	@utilityHeader(view) {
		{ children... }
	}
}

templ utilityHeader(view utilityHeaderView) {
	<header class="page-header hero-surface glass-panel relative overflow-hidden p-5 mb-4">
		if view.Background!="" {
			<img src={ view.Background } alt="" class="page-header__background pointer-events-none absolute inset-0 h-full w-full object-cover"/>
			<div class="page-header__background-shade pointer-events-none absolute inset-0"></div>
		}
		<div class="relative flex flex-wrap items-start justify-between gap-4">
			<div class="flex min-w-0 items-start gap-3">
				<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-blue-400/15 bg-blue-500/10 text-lg text-blue-400">
					@icon(view.Symbol)
				</span>
				<div class="min-w-0">
					if view.Eyebrow != "" {
						<p class="text-fine font-bold uppercase tracking-[0.16em] text-blue-400/70">{ view.Eyebrow }</p>
					}
					<h1 class="text-xl font-bold text-white">{ view.Title }</h1>
					if view.Description != "" || view.DescriptionContent!=nil {
						<div class="mt-1.5 max-w-3xl text-sm leading-relaxed text-gray-500">
							if view.DescriptionContent!=nil {
								@view.DescriptionContent
							} else {
								{ view.Description }
							}
						</div>
					}
				</div>
			</div>
			<div class="relative shrink-0">
				{ children... }
			</div>
		</div>
		if view.Meta!=nil {
			<div class="relative mt-4 border-t border-white/[0.06] pt-3">
				@view.Meta
			</div>
		}
	</header>
}

templ utilityLoginGate(message string) {
	<div class="glass-panel p-8 text-center" data-utility-login-gate>
		<span class="inline-block text-3xl text-gray-500 mb-3">
			@icon("log-in")
		</span>
		<p class="text-sm text-gray-400 mb-4">{ message }</p>
		<button type="button" data-utility-login class="px-4 py-2 rounded-lg text-sm font-medium bg-blue-500 text-white hover:bg-blue-600 transition-colors cursor-pointer">Log in with EVE Online</button>
		<p hidden data-utility-login-error role="alert" class="mt-3 text-sm text-red-400"></p>
	</div>
}
