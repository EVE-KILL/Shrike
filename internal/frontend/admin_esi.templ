package frontend

templ adminESI(view adminView) {
	<div class="space-y-4" data-admin-esi data-admin-esi-summary data-controller="admin-esi-summary" data-admin-esi-summary-admin-outlet="[data-admin-root]" data-action="click->admin-esi-summary#click pagehide@window->admin-esi-summary#hide pageshow@window->admin-esi-summary#show">
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
			<div class="glass-panel p-4"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-1">Requests (1h)</div><div data-admin-esi-count class="text-2xl font-bold text-white tabular-nums">—</div></div>
			<div class="glass-panel p-4"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-1">Requests (24h)</div><div class="text-2xl font-bold text-white tabular-nums">{ adminNumber(adminValue(view.Overview,"esi","requests24h")) }</div></div>
			<div class="glass-panel p-4"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-1">Errors (24h)</div><div class={ "text-2xl font-bold tabular-nums " + killBoolClass(adminFloat(adminValue(view.Overview, "esi", "errors24h")) > 100, "text-red-400", "text-white") }>{ adminNumber(adminValue(view.Overview,"esi","errors24h")) }</div><div class="text-xs text-gray-500 mt-1">{ adminRate(adminValue(view.Overview,"esi","errorRate"))+"%" }</div></div>
			<div class="glass-panel p-4"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-1">Avg Response</div><div class="text-2xl font-bold text-white tabular-nums"><span data-admin-esi-average>—</span><span class="text-sm text-gray-500 ml-0.5">ms</span></div></div>
			<div class="glass-panel p-4"><div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-1">P95 Response</div><div data-admin-esi-p95-tone class="text-2xl font-bold text-white tabular-nums"><span data-admin-esi-p95>—</span><span class="text-sm text-gray-500 ml-0.5">ms</span></div></div>
		</div>
		<div data-esi-volume data-new-items="true"></div>
		<p hidden data-admin-esi-error role="alert" class="glass-panel p-4 text-sm text-red-300"></p>
		@adminESILog(view.ESI)
	</div>
}

templ adminESILog(data adminESIData) {
	<div class="space-y-4" data-esi-log data-controller="esi-log" data-action="click->esi-log#click keydown->esi-log#keyboard input->esi-log#search pagehide@window->esi-log#hide pageshow@window->esi-log#show visibilitychange@document->esi-log#visibility" data-admin="true" data-endpoint="/api/admin/esi-logs" data-show-entity="true" data-initial={ settingsJSON(data.Logs) } data-entity={ settingsJSON(data.Entity) } data-failed={ killBoolClass(data.LogError, "true", "false") }>
		<div class="rounded-t-lg bg-white/[0.04] border border-b-0 border-white/[0.08] px-5 pt-5 pb-3 flex flex-col md:flex-row md:items-center gap-3 relative z-10">
			<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 flex-shrink-0">Request Log</h2>
			<div data-esi-log-filters class="flex-1 flex flex-wrap items-center gap-2">
				<div class="flex items-center gap-2 bg-white/[0.04] rounded-lg px-3 py-1.5 flex-1 min-w-[160px]">
					<span class="text-gray-600 text-sm">
						@icon("search")
					</span><input data-esi-log-search type="text" placeholder="Filter endpoint..." aria-label="Filter endpoint" class="bg-transparent text-xs text-white placeholder-gray-600 outline-none w-full"/>
				</div>
			</div>
			<div data-esi-log-actions class="flex items-center gap-3 flex-shrink-0">
				<span data-esi-log-count class="text-xs text-gray-600 tabular-nums"></span>
				<button type="button" data-esi-log-live aria-label="Auto-reload ON" title="Auto-reload ON" aria-pressed="true" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer bg-green-500/15 text-green-400 border border-green-500/20">
					<span class="text-xs">
						@icon("play")
					</span>Live
				</button>
			</div>
		</div>
		<div class="rounded-b-lg bg-white/[0.04] border border-t-0 border-white/[0.08] overflow-hidden"><p hidden data-esi-log-error role="alert" class="px-4 py-3 text-xs text-red-300"></p><div data-esi-log-table><div class="px-5 py-8 text-center text-gray-600 text-sm">Loading ESI requests…</div></div></div>
		<div hidden data-esi-log-pagination class="flex items-center justify-between mt-4"><button type="button" data-esi-log-page="prev" class="px-3 py-1.5 rounded text-sm text-gray-400 hover:text-blue-400 hover:bg-blue-500/[0.06] disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer">Previous</button><span data-esi-log-page-label class="text-xs text-gray-500 tabular-nums"></span><button type="button" data-esi-log-page="next" class="px-3 py-1.5 rounded text-sm text-gray-400 hover:text-blue-400 hover:bg-blue-500/[0.06] disabled:opacity-30 disabled:cursor-not-allowed transition-colors cursor-pointer">Next</button></div>
		@esiLogDialog()
	</div>
}
