package frontend

import (
	"github.com/eve-kill/shrike/internal/api"
	"strconv"
)

templ campaignCreatorPage(start string, user *api.Principal) {
	<div class="go-utility-page campaign-creator" data-campaign-creator data-controller="campaign-creator" data-action="click->campaign-creator#click input->campaign-creator#input change->campaign-creator#change search-pick->campaign-creator#pick focus@window->campaign-creator#focus pagehide@window->campaign-creator#hide pageshow@window->campaign-creator#show" data-start={ start }>
		@templ.JSONScript("campaign-creator-user", campaignCreatorIdentity(user)).WithType("application/json")
		@utilityPageHeader("Campaign Creator", "Create a campaign", "flag", "Track a conflict between sides, a single group's war effort, or all activity across a battlefield. Everything you set here is editable afterwards except the tracking mode.") {
			<a href="/campaigns" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-gray-400 bg-white/[0.04] border border-white/[0.08] hover:bg-white/[0.07] hover:text-gray-200 transition-colors flex-shrink-0">
				<span class="text-xs">
					@icon("arrow-left")
				</span>All campaigns
			</a>
		}
		<div data-campaign-login hidden?={ user!=nil }>
			@utilityLoginGate("You must be logged in to create campaigns")
		</div>
		<div data-campaign-form hidden?={ user==nil } class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_340px] gap-4 items-start">
			<div class="space-y-4 min-w-0">
				@campaignFormSection("mode", 1, "Tracking mode", "Decides which killmails count — this cannot be changed later.", false) {
					<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
						for _,mode:=range campaignCreatorModes {
							@campaignCreatorChoice("mode", mode.Key, mode.Label, mode.Description, mode.Icon, mode.Key == "conflict")
						}
					</div>
				}
				@campaignFormSection("identity", 2, "Name and description", "How the campaign shows up in listings and search.", false) {
					<div class="space-y-3">
						<div><label for="campaign-name" class="text-fine text-gray-500 mb-1 block">Name</label><input id="campaign-name" data-campaign-name type="text" maxlength="100" placeholder="e.g. The Battle for Vale — Imperium vs Fraternity" class="w-full px-3 py-2.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-sm text-white placeholder-gray-600 focus:border-blue-500/40 focus:outline-none"/><p data-campaign-name-error hidden class="text-fine text-amber-400 mt-1">At least 3 characters.</p></div>
						<div><label for="campaign-description" class="text-fine text-gray-500 mb-1 block">Description <span class="text-gray-700">(optional)</span></label><textarea id="campaign-description" data-campaign-description rows="2" maxlength="2000" placeholder="What is this war about?" class="w-full px-3 py-2.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-sm text-gray-300 placeholder-gray-600 focus:border-blue-500/40 focus:outline-none"></textarea></div>
					</div>
				}
				@campaignFormSection("sides", 3, "The sides", "Name each side and add the alliances, corporations or characters that fight for it.", false) {
					<div data-campaign-side-grid class="grid grid-cols-1 md:grid-cols-2 gap-3">
						@campaignCreatorSide(0, "Side 1")
						@campaignCreatorSide(1, "Side 2")
					</div>
				}
				@campaignFormSection("locations", 4, "Battlefield", "Limit the campaign to specific space. Leave empty to count kills everywhere.", true) {
					@searchPicker("locations", "Search battlefield", []string{"region", "constellation", "system"})
					<div data-campaign-locations hidden class="flex flex-wrap gap-1.5 mt-3"></div>
					<p data-campaign-location-hint hidden class="text-fine text-gray-600 mt-2">Pick at least one region, constellation or system — up to 5 regions, 5 constellations and 10 systems.</p>
				}
				@campaignFormSection("time", 5, "Time range", "EVE time (UTC). Kills outside this window are never counted.", false) {
					<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
						<div>
							<label class="text-fine text-gray-500 mb-1 block">Start</label>@dateTimePicker(dateTimePickerOptions{Name: "campaign_start", Value: start, Placeholder: "Pick a start", HideClear: true})
						</div>
						<div>
							<label class="text-fine text-gray-500 mb-1 block">End</label>
							<div class="flex items-center gap-3">
								<div class="flex-1 min-w-0">
									@dateTimePicker(dateTimePickerOptions{Name: "campaign_end", Placeholder: "Pick an end", Disabled: true})
								</div><label class="flex items-center gap-1.5 text-xs text-gray-400 cursor-pointer whitespace-nowrap"><input data-campaign-ongoing type="checkbox" checked class="accent-blue-500"/> Ongoing</label>
							</div>
						</div>
					</div>
					<div data-campaign-time-error hidden class="mt-2 flex items-center gap-1.5 text-xs text-red-400" role="alert">
						<span class="text-xs flex-shrink-0">
							@icon("circle-alert")
						</span><span data-error-text></span>
					</div>
					<div data-campaign-ongoing-note class="mt-2 text-fine text-gray-600"><span data-campaign-ongoing-description>Ongoing campaigns update hourly and auto-archive after 30 days without a matching kill.</span><span data-campaign-public-limit>Each character may have 3 active public ongoing campaigns.</span></div>
				}
				@campaignFormSection("visibility", 6, "Visibility", "Who can find and open this campaign.", false) {
					<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
						for _,choice:=range campaignCreatorVisibilities {
							@campaignCreatorChoice("visibility", choice.Key, choice.Label, choice.Description, choice.Icon, choice.Key == "0")
						}
					</div>
					<div data-campaign-grants hidden class="mt-4 pt-3 border-t border-white/[0.06]">
						<p class="text-fine text-gray-600 mb-2">Allow these entities to see it on their custom killboard — your own killboards always can.</p>@searchPicker("allowed", "Search allowed killboards", []string{"alliance", "corporation", "character"})
						<div data-campaign-allowed hidden class="flex flex-wrap gap-1.5 mt-3"></div>
					</div>
					<p data-campaign-inferred-grants hidden class="text-fine text-gray-600 mt-3">Shown on custom killboards whose entities are on one of the sides, and always on your own killboards.</p>
				}
				@campaignFormSection("prize", 7, "Funded prize pool", "Let pilots fund the campaign through the EVE-KILL.com corporation wallet and reward its top performers.", true) {
					<div data-campaign-no-prize class="flex items-center gap-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02] px-3 py-2.5 text-fine text-gray-600">
						<span class="text-gray-700 flex-shrink-0">
							@icon("trophy")
						</span>Prize campaigns need a fixed end time and lock their rules once funded.
					</div>
					<div data-campaign-prize-fields hidden class="space-y-4">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
							<div><label for="campaign-prize-metric" class="text-fine text-gray-500 mb-1 block">Ranking metric</label><select id="campaign-prize-metric" data-campaign-prize-metric class="w-full px-3 py-2.5 rounded-lg bg-gray-900 border border-white/[0.08] text-sm text-gray-300 focus:border-amber-500/40 focus:outline-none"><option value="0">Most kills</option><option value="1">Most losses</option><option value="2">Most ISK destroyed</option><option value="3">Most ISK lost</option></select><p data-campaign-metric-description class="text-fine text-gray-600 mt-1">Each qualifying killmail counts once per pilot.</p></div>
							<div>
								<label for="campaign-prize-winners" class="text-fine text-gray-500 mb-1 block">Number of winners</label>
								<select id="campaign-prize-winners" data-campaign-prize-winners class="w-full px-3 py-2.5 rounded-lg bg-gray-900 border border-white/[0.08] text-sm text-gray-300 focus:border-amber-500/40 focus:outline-none">
									for count:=3;count<=10;count++ {
										<option value={ strconv.Itoa(count) }>Top { strconv.Itoa(count) } pilots</option>
									}
								</select>
								<p class="text-fine text-gray-600 mt-1">Only pilots with a positive score qualify.</p>
							</div>
						</div>
						<div class="rounded-lg border border-amber-500/20 bg-amber-500/[0.06] p-3"><div class="flex flex-col sm:flex-row sm:items-end gap-3"><div class="flex-1 min-w-0"><div class="flex items-center justify-between gap-3 mb-1"><label for="campaign-prize-funding" class="text-fine text-gray-500">Fund from your EK Wallet at creation <span class="text-gray-700">(optional)</span></label><span class="text-fine text-gray-600">Available: <span data-campaign-wallet-balance class="text-amber-300">— ISK</span></span></div><div class="relative"><input id="campaign-prize-funding" data-campaign-prize-funding type="text" inputmode="decimal" placeholder="0" class="w-full px-3 py-2.5 pr-12 rounded-lg bg-black/20 border border-white/[0.08] text-sm text-white tabular-nums placeholder-gray-700 focus:border-amber-500/40 focus:outline-none"/><span class="absolute right-3 top-2.5 text-xs text-gray-600">ISK</span></div></div><button type="button" data-campaign-use-max disabled class="px-3 py-2.5 rounded-lg bg-amber-500/15 text-xs font-medium text-amber-300 hover:bg-amber-500/25 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Use max</button></div><p class="text-fine text-gray-600 mt-2">Charged atomically with campaign creation. If creation fails, no ISK leaves your wallet. Funding immediately locks the prize rules.</p></div>
						<div><div class="flex items-center justify-between gap-3 mb-2"><label class="text-fine text-gray-500">Payout split</label><button type="button" data-campaign-reset-splits class="text-fine text-blue-400 hover:text-blue-300 cursor-pointer">Reset to recommended</button></div><div data-campaign-splits class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-10 gap-2"></div><div class="flex items-center justify-between mt-2 text-xs"><span data-campaign-split-total class="text-green-400">Total: 100%</span><span class="text-gray-600">The split locks after the first matched contribution.</span></div></div>
						<div data-campaign-loss-warning hidden class="rounded-lg border border-amber-500/20 bg-amber-500/[0.08] px-3 py-2 text-xs text-amber-300">This metric rewards losses and may encourage intentional welping. Campaign results are not guaranteed to be fraud-proof.</div>
						<div class="rounded-lg border border-blue-500/15 bg-blue-500/[0.06] px-3 py-2 text-fine text-gray-400">Funding closes at the campaign end time. Official results are frozen 24 hours later so delayed killmails and wallet entries can catch up. Payouts are arranged manually through EVE-KILL Discord.</div>
						<div data-campaign-prize-error hidden role="alert" class="flex items-center gap-1.5 text-xs text-red-400">
							<span class="text-xs flex-shrink-0">
								@icon("circle-alert")
							</span><span data-error-text></span>
						</div>
					</div>
				}
			</div>
			<aside class="xl:sticky xl:top-4 space-y-3">
				<div class="glass-panel p-4">
					<div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-3">Preview</div>
					<div data-campaign-preview class="pointer-events-none">
						@campaignCard(campaignCreatorPreview(start))
					</div>
				</div>
				<div class="glass-panel p-4">
					<div class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-3">Before you create</div>
					<ul data-campaign-checklist class="space-y-2"></ul>
					<div data-campaign-submit-error hidden role="alert" class="mt-3 flex items-start gap-2 text-xs text-red-400 bg-red-500/10 rounded-lg px-3 py-2">
						<span class="text-sm mt-px flex-shrink-0">
							@icon("circle-alert")
						</span><span data-error-text class="min-w-0"></span>
					</div>
					<button type="button" data-campaign-create disabled class="w-full mt-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-white/[0.04] text-gray-600 cursor-not-allowed">
						<span data-campaign-creating-icon hidden class="text-base animate-spin mr-2">
							@icon("loader-2")
						</span><span data-campaign-submit-label>Create Campaign</span>
					</button>
					<p class="text-fine text-gray-600 text-center mt-2">The workload is estimated before creation. Accepted campaigns compute in the background under hard size and runtime limits.</p>
				</div>
			</aside>
		</div>
		<template id="campaign-side-template">
			@campaignCreatorSide(0, "")
		</template>
		<template id="campaign-participant-template">
			<div class="group flex items-center gap-2 px-1.5 py-1 rounded hover:bg-blue-500/[0.04] transition-colors">
				<img data-participant-image width="20" height="20" alt="" class="w-5 h-5 rounded flex-shrink-0 bg-gray-900" loading="lazy"/><span data-participant-name class="text-xs text-gray-300 truncate flex-1"></span><span data-participant-type class="text-fine text-gray-600 capitalize flex-shrink-0"></span>
				<button type="button" data-campaign-remove-entity class="opacity-0 group-hover:opacity-100 focus:opacity-100 text-gray-500 hover:text-red-400 transition-opacity flex-shrink-0 cursor-pointer">
					<span class="text-fine">
						@icon("x")
					</span>
				</button>
			</div>
		</template>
		<template id="campaign-location-template">
			<div class="inline-flex items-center gap-1.5 px-2 py-1 rounded border border-amber-500/30 bg-amber-500/10 text-xs text-amber-400 font-medium">
				<span class="text-fine">
					@icon("map-pin")
				</span><span data-tag-name></span>
				<button type="button" data-campaign-remove-location class="ml-0.5 opacity-60 hover:opacity-100 cursor-pointer">
					<span class="text-fine">
						@icon("x")
					</span>
				</button>
			</div>
		</template>
		<template id="campaign-allowed-template">
			<div class="inline-flex items-center gap-1.5 px-2 py-1 rounded border border-indigo-500/30 bg-indigo-500/10 text-xs text-indigo-300 font-medium">
				<img data-allowed-image width="16" height="16" alt="" loading="lazy" class="w-4 h-4 rounded"/><span data-tag-name></span>
				<button type="button" data-campaign-remove-allowed class="ml-0.5 opacity-60 hover:opacity-100 cursor-pointer">
					<span class="text-fine">
						@icon("x")
					</span>
				</button>
			</div>
		</template>
		<template id="campaign-prize-toggle"><label class="inline-flex items-center gap-2 text-xs text-gray-300 cursor-pointer whitespace-nowrap"><input data-campaign-prize-enabled type="checkbox" class="accent-amber-500"/> Enable prizes</label></template>
		<template id="campaign-side-add">
			<button type="button" data-campaign-add-side class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-fine font-medium text-gray-400 bg-white/[0.04] border border-white/[0.08] hover:bg-blue-500/[0.08] hover:text-blue-400 transition-colors cursor-pointer">
				<span class="text-fine">
					@icon("plus")
				</span><span>Add side (2/4)</span>
			</button>
		</template>
	</div>
}

templ campaignFormSection(key string, step int, title, hint string, optional bool) {
	<section class="glass-panel p-4" data-campaign-section={ key }>
		<header class="flex items-start gap-3 mb-3"><span data-campaign-step class="w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0 text-fine font-bold tabular-nums transition-colors bg-blue-500/15 text-blue-400">{ strconv.Itoa(step) }</span><div class="min-w-0"><div class="flex items-center gap-2 flex-wrap"><h2 data-campaign-section-title class="text-xs font-semibold text-gray-200">{ title }</h2><span data-campaign-section-optional hidden?={ !optional } class="text-fine text-gray-600">optional</span></div><p data-campaign-section-hint class="text-fine text-gray-600 mt-0.5">{ hint }</p></div><div data-campaign-section-aside hidden class="ml-auto flex-shrink-0"></div></header>
		{ children... }
	</section>
}

templ campaignCreatorChoice(group, key, label, description, symbol string, active bool) {
	<button type="button" data-campaign-choice={ group } data-value={ key } aria-pressed={ strconv.FormatBool(active) } class={ "flex items-start gap-3 rounded-lg border p-3 text-left transition-colors cursor-pointer " + killBoolClass(active, "border-blue-500/40 bg-blue-500/[0.08]", "border-white/[0.08] bg-white/[0.02] hover:bg-white/[0.05]") }>
		<span data-choice-icon class={ "text-lg mt-0.5 flex-shrink-0 " + killBoolClass(active, "text-blue-400", "text-gray-500") }>
			@icon(symbol)
		</span>
		<div class="min-w-0"><div data-choice-label class={ "text-sm font-medium " + killBoolClass(active, "text-white", "text-gray-300") }>{ label }</div><div class="text-fine text-gray-600 mt-0.5">{ description }</div></div>
	</button>
}

templ campaignCreatorSide(index int, name string) {
	<div data-campaign-side={ strconv.Itoa(index) } class={ "relative rounded-lg bg-white/[0.02] border p-3 pl-4 overflow-hidden " + campaignCreatorSideBorders[index] }>
		<div data-side-rail class="absolute inset-y-0 left-0 w-[3px]" style={ "background-color:" + campaignCreatorSideColors[index] }></div>
		<div class="flex items-center gap-2 mb-2.5">
			<input data-campaign-side-name type="text" maxlength="50" value={ name } aria-label={ "Side " + strconv.Itoa(index+1) + " name" } class={ "flex-1 min-w-0 px-2.5 py-1.5 rounded bg-white/[0.04] border border-white/[0.06] text-sm font-medium focus:border-blue-500/40 focus:outline-none " + campaignCreatorSideTexts[index] }/>
			<button type="button" data-campaign-remove-side aria-label={ "Remove side " + strconv.Itoa(index+1) } title="Remove side" class="px-2 py-1.5 rounded text-gray-600 hover:text-red-400 hover:bg-red-500/[0.08] transition-colors cursor-pointer flex-shrink-0">
				<span class="text-xs">
					@icon("x")
				</span>
			</button>
		</div>
		<div class="mb-2">
			@searchPicker("side", "Add side participant", []string{"alliance", "corporation", "character"})
		</div>
		<div data-side-entities class="space-y-0.5 min-h-[60px]"><div class="text-center py-4 text-fine text-gray-600">Add up to 15 alliances, corporations or characters</div></div>
		<div data-side-count class="text-fine text-gray-600 text-right mt-1 tabular-nums">0/15</div>
	</div>
}
