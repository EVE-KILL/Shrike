package frontend

import "strconv"

templ settingsDescription(view settingsView) {
	<div class="space-y-4" data-settings-description>
		<div class="glass-panel p-5">
			<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-3">Custom Bios</h2>
			<p class="text-xs text-gray-400 leading-relaxed">Set a custom bio for your character, and — if you're a CEO or alliance executor CEO — for your corporation or alliance. These override the ESI-sourced description on entity pages. Markdown is recommended for new bios; EVE HTML is supported for pasting existing in-game descriptions verbatim.</p>
			<p class="text-xs text-gray-500 mt-2">
				<span class="inline w-3 h-3 -mt-0.5">
					@icon("info")
				</span> Every submission is reviewed manually by an admin before it's published. Once approved, changes take effect within a few minutes as page caches refresh. Submitting an empty bio clears your published one immediately.
			</p>
		</div>
		if view.DescriptionError {
			<p class="glass-panel p-5 text-sm text-red-300" role="alert">Could not load your bios. <button type="button" data-settings-section-retry class="text-blue-400">Retry</button></p>
		}
		if bio:=view.Descriptions.Character;bio!=nil {
			@settingsBioEditor("character", "Character Bio", bio.Name, "Write something about yourself...", 8, bio)
		}
		if bio:=view.Descriptions.Corporation;bio!=nil {
			if bio.CanEdit {
				@settingsBioEditor("corporation", "Corporation Bio", "["+bio.Ticker+"] "+bio.Name, "Describe your corporation...", 10, bio)
			} else {
				<div class="rounded-lg bg-white/[0.02] border border-white/[0.06] p-5 opacity-70">
					<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-2">Corporation Bio</h2>
					<p class="text-xs text-gray-400">
						You're a member of <span class="text-gray-300">{ "["+bio.Ticker+"] "+bio.Name }</span>, but only the CEO
						if bio.CEOName!=nil {
							<span>{ " ("+*bio.CEOName+")" }</span>
						}
						can edit the corporation bio.
					</p>
				</div>
			}
		}
		if bio:=view.Descriptions.Alliance;bio!=nil {
			if bio.CanEdit {
				@settingsBioEditor("alliance", "Alliance Bio", "["+bio.Ticker+"] "+bio.Name, "Describe your alliance...", 10, bio)
			} else {
				<div class="rounded-lg bg-white/[0.02] border border-white/[0.06] p-5 opacity-70">
					<h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500 mb-2">Alliance Bio</h2>
					<p class="text-xs text-gray-400">
						You're a member of <span class="text-gray-300">{ "["+bio.Ticker+"] "+bio.Name }</span>, but only the executor corporation's CEO
						if bio.ExecutorCEOName!=nil {
							<span>{ " ("+*bio.ExecutorCEOName+")" }</span>
						}
						can edit the alliance bio.
					</p>
				</div>
			}
		}
	</div>
}

templ settingsBioEditor(entity, title, subtitle, placeholder string, rows int, bio *settingsBio) {
	<div class="glass-panel p-5" data-settings-bio={ entity } data-controller="settings-bio" data-action="click->settings-bio#click input->settings-bio#input pagehide@window->settings-bio#hide" data-format={ bio.format() }>
		<div class="flex items-start justify-between mb-4">
			<div><h2 class="text-fine font-bold uppercase tracking-[0.15em] text-gray-500">{ title }</h2><div class="text-xs text-gray-400 mt-1">{ subtitle }</div></div>
			<div class="flex items-center gap-2"><span hidden data-settings-bio-submitted class="text-xs text-blue-400" role="status">Submitted</span><button type="button" data-settings-bio-save class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer bg-blue-500/15 text-blue-400 hover:bg-blue-500/25">Save</button></div>
		</div>
		<div hidden?={ bio.Pending==nil } data-settings-bio-pending class="mb-3 rounded-md bg-yellow-500/10 border border-yellow-500/20 px-3 py-2 text-xs text-yellow-400 flex items-start gap-2">
			<span class="w-3.5 h-3.5 mt-0.5 flex-shrink-0">
				@icon("clock")
			</span><span>You have a submission pending admin review. The text below is your last submission — save again to update it, or leave it blank and save to withdraw.</span>
		</div>
		<div class="flex gap-1 mb-3">
			@settingsBioFormat("markdown", "Markdown", bio.format())
			@settingsBioFormat("eve_html", "EVE HTML", bio.format())
		</div>
		<textarea rows={ strconv.Itoa(rows) } maxlength="4000" placeholder={ placeholder } aria-label={ title } class="w-full px-3 py-2 rounded-md bg-black/30 border border-white/[0.08] text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-blue-500/40 font-mono">{ bio.text() }</textarea>
		<div class="flex items-center justify-between mt-1"><span data-settings-bio-count class="text-fine text-gray-500">{ strconv.Itoa(len([]rune(bio.text()))) } / 4000</span></div>
		<p hidden data-settings-bio-error role="alert" class="text-xs text-red-400 mt-2"></p>
	</div>
}

templ settingsBioFormat(value, label, selected string) {
	<button type="button" data-settings-bio-format={ value } aria-pressed={ killBoolClass(value == selected, "true", "false") } class={ "px-3 py-1 rounded-md text-xs font-medium transition-colors cursor-pointer " + killBoolClass(value == selected, "bg-blue-500/15 text-blue-400", "bg-white/[0.04] text-gray-500 hover:bg-white/[0.08]") }>{ label }</button>
}
