package frontend

templ docsPage() {
	<div class="docs-page" data-controller="docs" data-action="input->docs#search click->docs#click toggle->docs#toggle:capture pagehide@window->docs#hide pageshow@window->docs#show">
		<header class="page-header hero-surface glass-panel docs-header">
			<span class="page-header-icon"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3H6a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h2m8-16h2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-2"></path></svg></span>
			<div class="docs-header-main">
				<p class="eyebrow">Build with EVE-KILL</p>
				<h1>API Documentation</h1>
				<p>The API powering eve-kill.com. JSON, CORS-open, and read endpoints need no authentication. Click any endpoint to expand it, fill in the parameters, and hit <span class="docs-try-label">Try it</span> — requests fire straight against the live API.</p>
			</div>
			<div class="docs-header-meta" id="docs-spec-meta" hidden><span id="docs-spec-title"></span><span id="docs-spec-version"></span><a href="/api/openapi.json" target="_blank" rel="noopener">openapi.json</a></div>
		</header>
		<div class="glass-panel docs-loading" id="docs-loading">Loading the API document…</div>
		<div class="docs-error" id="docs-error" hidden><strong>Failed to load the API document</strong><span id="docs-error-message"></span><button type="button" id="docs-retry">Retry</button></div>
		<div class="docs-layout" id="docs-layout" hidden>
			<aside class="docs-sidebar">
				<label class="docs-search">
					@icon("search")
					<input type="search" id="docs-search" placeholder="Filter endpoints…" aria-label="Filter endpoints" autocomplete="off"/>
				</label>
				<div class="docs-count" id="docs-count"></div>
				<nav id="docs-nav" aria-label="API sections"></nav>
			</aside>
			<div class="docs-content" id="docs-content"></div>
		</div>
		<script type="module" src={ assetURL("docs.js") }></script>
	</div>
}
