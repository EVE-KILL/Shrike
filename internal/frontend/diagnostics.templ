package frontend

templ diagnostics() {
	<details id="dev-diagnostics" class="dev-diagnostics" data-controller="diagnostics" data-action="keydown->diagnostics#keyboard load@window->diagnostics#loaded">
		<summary aria-label="Development performance diagnostics">
			<span class="diagnostics-dot" aria-hidden="true"></span>
			<span class="diagnostics-label">DEV</span>
			<span><strong data-metric="app">—</strong> ms server</span>
			<span class="diagnostics-separator"></span>
			<span><strong data-metric="dbcount">—</strong> SQL</span>
			<span class="diagnostics-chevron" aria-hidden="true">⌃</span>
		</summary>
		<section class="diagnostics-panel" aria-labelledby="diagnostics-title">
			<header class="diagnostics-header">
				<div><h2 id="diagnostics-title">Request performance</h2><p>Go renderer · development only</p></div>
				<button id="diagnostics-close" type="button" aria-label="Close diagnostics" data-action="click->diagnostics#close">×</button>
			</header>
			<div class="diagnostics-overview">
				<div class="diagnostics-primary-stat">
					<span class="diagnostics-stat-label">PAGE SERVER TIME</span>
					<div class="diagnostics-stat-value"><strong data-metric="app">—</strong><span>ms</span></div>
					<p>Loading, templates, and response setup</p>
				</div>
				<div class="diagnostics-primary-stat">
					<span class="diagnostics-stat-label">SQL QUERIES</span>
					<div class="diagnostics-stat-value"><strong data-metric="dbcount">—</strong></div>
					<p>DB client time <strong data-metric="db">—</strong> ms</p>
				</div>
			</div>
			<div class="diagnostics-section-heading"><h3>Where server time went</h3><span>Parts of page server time</span></div>
			<div class="diagnostics-breakdown">
				<div class="diagnostics-breakdown-row"><div><span>Data loading</span><strong><span data-metric="load">—</span> ms</strong></div><div class="diagnostics-track"><span class="diagnostics-fill diagnostics-fill--load" data-part="load"></span></div></div>
				<div class="diagnostics-breakdown-row"><div><span>Templates</span><strong><span data-metric="render">—</span> ms</strong></div><div class="diagnostics-track"><span class="diagnostics-fill diagnostics-fill--render" data-part="render"></span></div></div>
				<div class="diagnostics-breakdown-row"><div><span>Other server work</span><strong><span data-metric="other">—</span> ms</strong></div><div class="diagnostics-track"><span class="diagnostics-fill diagnostics-fill--other" data-part="other"></span></div></div>
			</div>
			<div class="diagnostics-db-details"><span>Pool acquisition <strong><span data-metric="dbwait">—</span> ms</strong></span><span>DB errors <strong data-metric="dberrors">—</strong></span><span>Batches <strong data-metric="dbbatches">—</strong></span><span>COPY <strong data-metric="dbcopies">—</strong></span></div>
			<div class="diagnostics-section-heading"><h3>Browser navigation</h3><span>Measured in the browser</span></div>
			<div class="diagnostics-browser-steps">
				<div><span>Before request</span><strong><span data-browser="setup">—</span> ms</strong></div>
				<div><span>Request → first byte</span><strong><span data-browser="ttfb">—</span> ms</strong></div>
				<div><span>Body transfer</span><strong><span data-browser="transfer">—</span> ms</strong></div>
			</div>
			<div class="diagnostics-browser-totals"><span>Navigation → first byte <strong><span data-browser="navigation">—</span> ms</strong></span><span>DOM ready <strong><span data-browser="dom">—</span> ms</strong></span></div>
			<div class="diagnostics-section-heading diagnostics-requests-heading"><h3>Recent API requests</h3><button id="diagnostics-clear" type="button" data-action="click->diagnostics#clear">Clear</button></div>
			<div class="diagnostics-table-scroll"><table><thead><tr><th scope="col">Request</th><th scope="col">Server</th><th scope="col">SQL</th><th scope="col">DB time</th></tr></thead><tbody id="diagnostics-requests"><tr><td colspan="4">Open search or use a page control to see its requests.</td></tr></tbody></table></div>
			<details class="diagnostics-explainer"><summary>How are these times measured?</summary><p>The server figure stops before transferring the response. Browser times also include navigation setup and transport. Database time includes driver work and row consumption, and parallel query times can overlap. Counts come from pgx. No SQL text or parameters are recorded.</p></details>
			<p id="diagnostics-status" class="diagnostics-note" role="status"></p>
		</section>
	</details>
}
