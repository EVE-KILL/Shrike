package frontend

// The inert templates are emitted once per document. Each root/reply/edit
// composer clones the original CommentInput controls without a fragment trip.
templ commentInputTemplates() {
	<template id="comment-input-template">
		<div class="go-utility-page">
			<form class="comment-input rounded-lg border border-white/[0.08] bg-black/30" data-comment-input>
				<div class="flex items-center gap-1 px-2 pt-2 border-b border-white/[0.06] flex-wrap">
					<div class="flex items-center gap-1" role="tablist" aria-label="Comment editor">
						<button type="button" data-comment-tab="write" role="tab" aria-selected="true" class="comment-editor-tab px-3 py-1 text-xs rounded-md transition-colors cursor-pointer">Write</button>
						<button type="button" data-comment-tab="preview" role="tab" aria-selected="false" class="comment-editor-tab px-3 py-1 text-xs rounded-md transition-colors cursor-pointer">Preview</button>
					</div>
					<div class="flex-1"></div>
					<div class="flex items-center gap-0.5 flex-wrap" data-comment-toolbar role="group" aria-label="Comment formatting">
						@commentToolbarButton("bold", "Bold", "bold")
						@commentToolbarButton("italic", "Italic", "italic")
						@commentToolbarButton("strikethrough", "Strikethrough", "strike")
						@commentToolbarButton("code", "Code", "code")
						@commentToolbarButton("quote", "Quote", "quote")
						@commentToolbarButton("link", "Insert link", "link")
						<span class="toolbar-divider"></span>
						@commentToolbarButton("image", "Insert image", "image")
						@commentToolbarButton("youtube", "Insert YouTube video", "youtube")
						@commentToolbarButton("imgur", "Insert Imgur image", "imgur")
						@commentToolbarButton("image-play", "Pick a GIF", "gif")
					</div>
				</div>
				<div class="p-2">
					<textarea name="body_md" aria-label="Comment text" data-comment-body class="w-full min-h-[80px] max-h-[300px] bg-transparent text-sm text-white placeholder-gray-600 focus:outline-none resize-y"></textarea>
					<div data-comment-preview hidden class="comment-body min-h-[80px] text-sm text-gray-200"></div>
				</div>
				<div data-comment-error hidden role="alert" class="mx-2 mb-2 px-2.5 py-1.5 rounded-md bg-red-500/[0.08] border border-red-500/20 text-xs text-red-300 flex items-start gap-2">
					@icon("triangle-alert")
					<span class="flex-1" data-comment-error-text></span>
					<button type="button" data-comment-dismiss aria-label="Dismiss error" class="text-red-400/70 hover:text-red-300 cursor-pointer flex-shrink-0">
						@icon("x")
					</button>
				</div>
				<div class="flex items-center gap-2 px-2 pb-2 text-xs">
					<span data-comment-count class="text-gray-600">0 / 2000</span>
					<div class="flex-1"></div>
					<button type="button" data-comment-input-cancel hidden class="px-3 py-1 rounded-md text-gray-400 hover:text-white hover:bg-white/[0.06] transition-colors cursor-pointer">Cancel</button>
					<button type="submit" data-comment-submit disabled class="px-3 py-1 rounded-md bg-blue-500/[0.15] text-blue-300 hover:bg-blue-500/[0.25] disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">Post</button>
				</div>
			</form>
		</div>
	</template>
	<template id="comment-embed-template">
		<dialog class="comment-dialog" aria-label="Insert media">
			<div class="go-utility-page">
				<form data-comment-embed novalidate>
					<header class="comment-dialog-header">
						<h2 class="text-sm font-semibold text-white flex items-center gap-2"><span data-embed-icon></span><span data-embed-title></span></h2>
						<button type="button" data-dialog-close aria-label="Close media dialog" class="text-gray-500 hover:text-white">
							@icon("x")
						</button>
					</header>
					<div class="comment-dialog-body space-y-3">
						<div>
							<label class="block text-xs font-semibold text-gray-400 mb-1.5 uppercase tracking-wide"><span>URL</span><input name="url" type="url" data-embed-url autofocus class="comment-embed-url w-full px-3 py-2 bg-black/40 border border-white/[0.08] rounded-md text-sm text-white placeholder-gray-600 focus:outline-none focus:border-blue-500/50"/></label>
							<p data-embed-error hidden class="mt-1.5 text-xs text-amber-400" role="alert"></p>
						</div>
						<div data-embed-preview hidden class="rounded-md border border-white/[0.08] bg-black/40 p-3">
							<div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Preview</div>
							<img alt="preview" class="max-w-full max-h-60 mx-auto rounded object-contain"/>
						</div>
						<div data-embed-hint hidden class="rounded-md border border-white/[0.08] bg-black/40 p-3 text-xs text-gray-500">Embed will render in the comment.</div>
					</div>
					<footer class="comment-dialog-footer flex items-center justify-end gap-2">
						<button type="button" data-dialog-close class="px-3 py-1 rounded-md text-sm text-gray-400 hover:text-white hover:bg-white/[0.06] cursor-pointer">Cancel</button>
						<button type="submit" data-embed-insert class="px-3 py-1 rounded-md text-sm bg-blue-500/[0.15] text-blue-300 hover:bg-blue-500/[0.25] disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Insert</button>
					</footer>
				</form>
			</div>
		</dialog>
	</template>
	<template id="comment-gif-template">
		<dialog class="comment-dialog comment-gif-dialog" aria-label="Add a GIF">
			<div class="go-utility-page">
				<header class="comment-dialog-header">
					<h2 class="text-sm font-semibold text-white flex items-center gap-2">
						<span class="text-purple-400">
							@icon("image-play")
						</span> Add a GIF <span class="text-xs font-normal text-gray-600">powered by KLIPY</span>
					</h2>
					<button type="button" data-dialog-close aria-label="Close GIF picker" class="text-gray-500 hover:text-white">
						@icon("x")
					</button>
				</header>
				<div class="comment-dialog-body space-y-3">
					<div class="relative">
						<span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">
							@icon("search")
						</span>
						<input type="search" data-gif-search placeholder="Search KLIPY" aria-label="Search KLIPY" autofocus class="w-full pl-9 pr-9 py-2 bg-black/40 border border-white/[0.08] rounded-md text-sm text-white placeholder-gray-600 focus:outline-none focus:border-blue-500/50"/>
						<button type="button" data-gif-clear hidden aria-label="Clear GIF search" class="absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded text-gray-500 hover:text-white hover:bg-white/[0.06] cursor-pointer">
							@icon("x")
						</button>
					</div>
					<div class="flex items-center gap-1 border-b border-white/[0.06]" role="tablist" aria-label="GIF catalog">
						<button type="button" data-gif-tab="trending" role="tab" class="klipy-tab">
							@icon("flame")
							Trending
						</button>
						<button type="button" data-gif-tab="search" role="tab" hidden class="klipy-tab">
							@icon("search")
							Results
						</button>
						<button type="button" data-gif-tab="favorites" role="tab" class="klipy-tab">
							@icon("star")
							Favorites <span data-gif-favorites-count class="text-xs text-gray-600"></span>
						</button>
					</div>
					<div class="klipy-grid" data-gif-grid></div>
					<div data-gif-more-wrap hidden class="text-center"><button type="button" data-gif-more class="px-3 py-1.5 rounded-md text-xs text-blue-400 hover:text-blue-300 hover:bg-blue-500/[0.08] cursor-pointer disabled:opacity-40">Load more</button></div>
				</div>
			</div>
		</dialog>
	</template>
	<template id="comment-report-template">
		<dialog class="comment-dialog" aria-label="Report comment">
			<div class="go-utility-page">
				<form data-comment-report>
					<header class="comment-dialog-header">
						<h2 class="text-sm font-semibold text-white">Report comment</h2>
						<button type="button" data-dialog-close aria-label="Close report dialog" class="text-gray-500 hover:text-white">
							@icon("x")
						</button>
					</header>
					<div class="comment-dialog-body space-y-3">
						<label class="block text-xs font-semibold text-gray-400 uppercase tracking-wide">Reason<select name="reason" aria-label="Reason" class="mt-1.5 w-full px-3 py-2 bg-black/40 border border-white/[0.08] rounded-md text-sm text-white"><option value="spam">Spam</option><option value="harassment">Harassment</option><option value="nsfw">NSFW / inappropriate</option><option value="offtopic">Off-topic</option><option value="other">Other</option></select></label>
						<label class="block text-xs font-semibold text-gray-400 uppercase tracking-wide">Additional info (optional)<textarea name="message" maxlength="1000" aria-label="Additional info (optional)" placeholder="Anything we should know?" rows="3" class="mt-1.5 w-full min-h-[80px] px-3 py-2 bg-black/40 border border-white/[0.08] rounded-md text-sm text-white"></textarea></label>
						<p data-report-error hidden role="alert" class="text-xs text-red-400"></p>
					</div>
					<footer class="comment-dialog-footer flex items-center justify-end gap-2"><button type="button" data-dialog-close class="px-3 py-1 rounded-md text-sm text-gray-400 hover:text-white">Cancel</button><button type="submit" class="px-3 py-1 rounded-md text-sm bg-red-500/[0.15] text-red-300 hover:bg-red-500/[0.25] disabled:opacity-40 cursor-pointer">Report</button></footer>
				</form>
			</div>
		</dialog>
	</template>
}

templ commentToolbarButton(name, label, action string) {
	<button type="button" class="toolbar-btn" aria-label={ label } title={ label } data-comment-action={ action }>
		@icon(name)
	</button>
}
