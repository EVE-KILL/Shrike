package frontend

import "strconv"

templ adminDomains(view adminView) {
	<div class="space-y-4" data-admin-domains data-controller="admin-domains" data-action="click->admin-domains#click input->admin-domains#render" data-initial={ settingsJSON(view.Domains) }>
		<div class="glass-panel p-4 flex flex-col md:flex-row md:items-center gap-3">
			<div class="flex items-center gap-3 flex-1 min-w-0">
				<span class="text-gray-500 flex-shrink-0">
					@icon("search")
				</span><input data-admin-domain-search type="text" placeholder="Search subdomain, site name or owner..." aria-label="Search domains" class="flex-1 min-w-0 bg-transparent text-sm text-white placeholder-gray-600 outline-none"/>
			</div>
			<div class="flex items-center gap-1 rounded-md bg-white/[0.03] border border-white/[0.06] p-1 flex-shrink-0">
				for i,key:=range []string{"all","pending","inactive"} {
					<button type="button" data-admin-domain-filter={ key } aria-pressed={ killBoolClass(key == "all", "true", "false") } class={ "px-3 py-1 rounded text-xs font-medium transition-colors cursor-pointer flex items-center gap-1.5 " + killBoolClass(key == "all", "bg-blue-500/[0.15] text-blue-300", "text-gray-400 hover:text-white") }>{ []string{"All","Pending assets","Inactive"}[i] }<span class={ "tabular-nums " + killBoolClass(key == "all", "text-blue-400/70", "text-gray-600") }>{ strconv.Itoa(view.Domains.count(key)) }</span></button>
				}
			</div>
		</div>
		if view.Domains.Failed {
			<p class="glass-panel p-4 text-sm text-red-300" role="alert">Could not load domains. <button type="button" data-admin-section-retry class="text-blue-400">Retry</button></p>
		}
		<div class="glass-panel overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead><tr class="border-b border-white/[0.06] text-left text-fine text-gray-500 uppercase tracking-wider"><th class="px-4 py-3">Domain</th><th class="px-4 py-3 hidden md:table-cell">Owner</th><th class="px-4 py-3 hidden md:table-cell">Entities</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Pending</th><th class="px-4 py-3"></th></tr></thead>
					<tbody>
						for _,d:=range view.Domains.Domains {
							<tr data-admin-domain-row={ strconv.FormatInt(d.ID, 10) } class="border-b border-white/[0.04] hover:bg-white/[0.02] transition-colors">
								<td class="px-4 py-3"><div class="font-medium text-white">{ domainDefault(d.Name,d.Subdomain) }</div><div class="text-fine text-gray-500">{ d.Subdomain+".eve-kill.com" }</div></td>
								<td class="px-4 py-3 hidden md:table-cell"><a href={ "/character/" + strconv.FormatInt(d.OwnerID, 10) } class="flex items-center gap-2 text-gray-300 hover:text-blue-400"><img src={ eveEntityImage("character", d.OwnerID, 32) } alt="" width="20" height="20" class="w-5 h-5 rounded-full" loading="lazy"/>{ adminDomainOwner(d) }</a></td>
								<td class="px-4 py-3 hidden md:table-cell text-gray-400">{ strconv.Itoa(len(d.Entities)) }</td>
								<td class="px-4 py-3"><span class={ "text-xs font-medium " + killBoolClass(d.Active, "text-green-400", "text-red-400") }>{ killBoolClass(d.Active,"Active","Inactive") }</span></td>
								<td class="px-4 py-3">
									if d.Pending>0 {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-400 text-fine font-medium">
											<span class="text-xs">
												@icon("clock")
											</span>{ strconv.Itoa(d.Pending) }
										</span>
									} else {
										<span class="text-fine text-gray-600">0</span>
									}
								</td>
								<td class="px-4 py-3 text-right"><a href={ adminDomainDetailPath(d.ID) } class="px-3 py-1.5 rounded-md text-fine font-medium text-blue-400 hover:bg-blue-500/10 transition-colors">Manage</a></td>
							</tr>
						}
						<tr data-admin-domain-empty hidden?={ len(view.Domains.Domains)>0 }><td colspan="6" class="px-4 py-8 text-center text-gray-500 text-sm">{ killBoolClass(len(view.Domains.Domains)>0,"No domains match these filters.","No custom domains found") }</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ adminDomainDetail(data adminDomainDetailData) {
	<div class="go-utility-page admin-page w-full" data-admin-domain-detail data-controller="admin-domain-detail" data-action="click->admin-domain-detail#click input->admin-domain-detail#input pagehide@window->admin-domain-detail#hide pageshow@window->admin-domain-detail#show" data-domain-id={ strconv.FormatInt(data.Domain.ID, 10) }>
		<div data-admin-domain-header>
			@adminDomainHeader(*data.Domain)
		</div>
		<div data-admin-domain-content>
			@adminDomainContent(data)
		</div>
	</div>
}

templ adminDomainHeader(d adminDomain) {
	<div class="mb-6">
		<a href="/admin/domains" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-400 transition-colors mb-3">
			<span class="text-base">
				@icon("arrow-left")
			</span>Back to Domains
		</a>
		<div class="hero-surface glass-panel p-5">
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0"><h1 class="text-lg font-bold text-white">{ domainDefault(d.Name,d.Subdomain) }</h1><p class="text-sm text-gray-400 mt-0.5">{ d.Subdomain+".eve-kill.com" }</p><div class="flex items-center gap-4 mt-2 text-xs text-gray-500"><a href={ "/character/" + strconv.FormatInt(d.OwnerID, 10) } class="flex items-center gap-1.5 hover:text-blue-400"><img src={ eveEntityImage("character", d.OwnerID, 32) } alt="" width="16" height="16" class="w-4 h-4 rounded-full"/>{ adminDomainOwner(d) }</a><span>{ "Created "+adminDate(d.Created) }</span></div></div>
				<div class="flex items-center gap-2">
					<span class={ "text-xs font-medium " + killBoolClass(d.Active, "text-green-400", "text-red-400") }>{ killBoolClass(d.Active,"Active","Inactive") }</span>
					<button type="button" data-admin-domain-toggle class={ "px-3 py-1.5 rounded-md text-xs font-medium transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed " + killBoolClass(d.Active, "text-red-400 hover:bg-red-500/10 border border-red-500/20", "text-green-400 hover:bg-green-500/10 border border-green-500/20") }>
						<span hidden data-admin-domain-toggle-spinner class="text-xs animate-spin mr-1 inline">
							@icon("loader-circle")
						</span>{ killBoolClass(d.Active,"Deactivate","Activate") }
					</button>
				</div>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4 pt-4 border-t border-white/[0.06]">
				<div>
					<div class="text-fine text-gray-500 uppercase tracking-wider">Entities</div>
					<div class="mt-1 flex flex-wrap gap-1">
						for _,e:=range d.Entities {
							<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-fine bg-white/[0.06] text-gray-300"><img src={ settingsEntityImage(e) } alt="" width="12" height="12" class="w-3 h-3 rounded-full"/>{ e.Name }</span>
						}
					</div>
				</div>
				<div><div class="text-fine text-gray-500 uppercase tracking-wider">Description</div><div class="mt-1 text-xs text-gray-300">{ domainDefault(d.Description,"—") }</div></div>
				<div><div class="text-fine text-gray-500 uppercase tracking-wider">Navbar Links</div><div class="mt-1 text-xs text-gray-300">{ strconv.Itoa(len(d.Navbar))+" links" }</div></div>
				<div><div class="text-fine text-gray-500 uppercase tracking-wider">Updated</div><div class="mt-1 text-xs text-gray-300">{ adminDate(d.Updated) }</div></div>
			</div>
		</div>
	</div>
}

templ adminDomainContent(data adminDomainDetailData) {
	<div data-admin-domain-tabs class="flex gap-1 mb-4">
		<button type="button" data-admin-domain-tab="approvals" aria-pressed="true" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer bg-blue-500/10 text-blue-400">
			Approvals
			if count:=len(data.pending());count>0 {
				<span class="ml-1.5 px-1.5 py-0.5 rounded-full bg-yellow-500/20 text-yellow-400 text-fine font-medium">{ strconv.Itoa(count) }</span>
			}
		</button>
		<button type="button" data-admin-domain-tab="files" aria-pressed="false" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer text-gray-500 hover:text-blue-400 hover:bg-blue-500/[0.04]">Files <span class="ml-1.5 text-fine text-gray-600">{ "("+strconv.Itoa(len(data.Assets))+")" }</span></button>
	</div>
	<div data-admin-domain-panel="approvals" class="space-y-4">
		if len(data.pending())==0 {
			<div class="glass-panel p-8 text-center">
				<span class="text-3xl text-green-400/50 mb-2">
					@icon("circle-check")
				</span>
				<p class="text-sm text-gray-400">No pending approvals</p>
			</div>
		}
		for _,asset:=range data.pending() {
			<div data-admin-domain-asset={ strconv.FormatInt(asset.ID, 10) } class="glass-panel overflow-hidden">
				<div class="p-4">
					<div class="flex flex-wrap items-center justify-between gap-2 mb-3"><div class="flex items-center gap-2"><span class={ "px-2 py-0.5 rounded-full text-fine font-medium " + adminAssetTone(asset.Status) }>{ asset.Status }</span><span class="text-sm font-medium text-white capitalize">{ asset.Type }</span><span class="text-fine text-gray-500">{ adminAssetSize(asset.Size)+" · "+asset.ContentType }</span></div><span class="text-fine text-gray-500">{ adminDate(asset.Created) }</span></div>
					<div class={ "rounded-lg overflow-hidden border border-white/[0.08] bg-black/20 " + killBoolClass(asset.Type == "logo", "w-24 h-24", "w-full h-40") }><img src={ adminAssetPreviewPath(data.Domain.ID, asset.ID) } alt={ asset.Type } class="w-full h-full object-cover"/></div>
				</div>
				<div class="px-4 py-3 bg-white/[0.02] border-t border-white/[0.06] flex flex-col sm:flex-row sm:items-center gap-3">
					<button type="button" data-admin-domain-review="approve" class="self-start shrink-0 whitespace-nowrap px-4 py-2 rounded-md text-sm font-medium bg-green-500/20 text-green-400 hover:bg-green-500/30 transition-colors disabled:opacity-50 cursor-pointer">
						<span class="text-base mr-1">
							@icon("check")
						</span>{ " Approve" }
					</button>
					<div class="w-full sm:w-auto min-w-0 flex-1 flex items-center gap-2">
						<input data-admin-domain-reason type="text" placeholder="Reason (optional)" aria-label={ "Rejection reason for asset " + strconv.FormatInt(asset.ID, 10) } class="min-w-0 flex-1 px-3 py-2 rounded-md bg-white/[0.04] border border-white/[0.08] text-sm text-white placeholder-gray-600 focus:outline-none focus:border-red-500/50"/>
						<button type="button" data-admin-domain-review="reject" class="shrink-0 whitespace-nowrap px-4 py-2 rounded-md text-sm font-medium bg-red-500/20 text-red-400 hover:bg-red-500/30 transition-colors disabled:opacity-50 cursor-pointer">
							<span class="text-base mr-1">
								@icon("x")
							</span>{ " Reject" }
						</button>
					</div>
				</div>
			</div>
		}
	</div>
	<div hidden data-admin-domain-panel="files" class="space-y-4">
		if len(data.Assets)==0 {
			<div class="glass-panel p-8 text-center">
				<span class="text-3xl text-gray-600 mb-2">
					@icon("folder-open")
				</span>
				<p class="text-sm text-gray-400">No files uploaded</p>
			</div>
		}
		<div class="glass-panel overflow-x-auto">
			if len(data.Assets)>0 {
				<table class="w-full text-sm">
					<thead><tr class="border-b border-white/[0.06] text-left text-fine text-gray-500 uppercase tracking-wider"><th class="px-4 py-3">Preview</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Status</th><th class="px-4 py-3 hidden md:table-cell">Size</th><th class="px-4 py-3 hidden md:table-cell">Uploaded</th><th class="px-4 py-3 hidden md:table-cell">Reviewed</th><th class="px-4 py-3">Actions</th></tr></thead>
					<tbody>
						for _,asset:=range data.Assets {
							<tr data-admin-domain-asset={ strconv.FormatInt(asset.ID, 10) } class="border-b border-white/[0.04] hover:bg-white/[0.02] transition-colors">
								<td class="px-4 py-3"><div class={ "rounded overflow-hidden border border-white/[0.08] bg-black/20 " + killBoolClass(asset.Type == "logo", "w-10 h-10", "w-24 h-14") }><img data-src={ adminAssetPreviewPath(data.Domain.ID, asset.ID) } alt={ asset.Type } class="w-full h-full object-cover"/></div></td>
								<td class="px-4 py-3 capitalize text-gray-300">{ asset.Type }</td>
								<td class="px-4 py-3">
									<span class={ "px-2 py-0.5 rounded-full text-fine font-medium " + adminAssetTone(asset.Status) }>{ asset.Status }</span>
									if asset.Reason!="" {
										<div class="text-fine text-red-400/70 mt-1">{ asset.Reason }</div>
									}
								</td>
								<td class="px-4 py-3 hidden md:table-cell text-fine text-gray-400">{ adminAssetSize(asset.Size) }</td>
								<td class="px-4 py-3 hidden md:table-cell text-fine text-gray-500">{ adminDate(asset.Created) }</td>
								<td class="px-4 py-3 hidden md:table-cell text-fine text-gray-500">{ adminDate(asset.Reviewed) }</td>
								<td class="px-4 py-3">
									if asset.Status=="pending" {
										<div class="flex items-center gap-1">
											<button
												type="button"
												data-admin-domain-review="approve"
												aria-label={ "Approve asset " + strconv.FormatInt(asset.ID, 10) }
												title="Approve"
												class="p-1.5 rounded text-green-400 hover:bg-green-500/10 transition-colors cursor-pointer"
											>
												<span class="text-sm">
													@icon("check")
												</span>
											</button>
											<button type="button" data-admin-domain-review="reject" aria-label={ "Reject asset " + strconv.FormatInt(asset.ID, 10) } title="Reject" class="p-1.5 rounded text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer">
												<span class="text-sm">
													@icon("x")
												</span>
											</button>
										</div>
									} else {
										<span class="text-fine text-gray-600">—</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</div>
}
