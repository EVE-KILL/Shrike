package frontend

import (
	"net/url"
	"strconv"
)

templ adminBlog(data adminBlogData) {
	<div class="space-y-4" data-admin-blog data-controller="admin-blog" data-action="click->admin-blog#click input->admin-blog#input change->admin-blog#input cancel->admin-blog#close:capture pagehide@window->admin-blog#hide pageshow@window->admin-blog#show" data-status={ data.Status } data-failed={ strconv.FormatBool(data.Failed) }>
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-2" data-admin-blog-filter></div>
			<button type="button" data-admin-blog-new class="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium transition-colors cursor-pointer">
				<span class="text-sm">
					@icon("plus")
				</span>New Post
			</button>
		</div>
		<p hidden?={ !data.Failed } data-admin-blog-error role="alert" class="glass-panel p-4 text-sm text-red-300">Could not load blog posts. <button type="button" data-admin-blog-retry class="text-blue-400">Retry</button></p>
		<div data-admin-blog-results>
			@adminBlogList(data)
		</div>
		@adminModalFrame("New Post", "Close post editor", "admin-blog-modal", adminBlogForm(), adminBlogFooter())
	</div>
}

templ adminBlogList(data adminBlogData) {
	<div data-admin-blog-list data-initial={ settingsJSON(data) }>
		if len(data.Posts) == 0 && !data.Failed {
			<div class="text-center py-12 text-gray-500 text-sm">No blog posts found.</div>
		} else {
			<div class="space-y-2">
				for _,p := range data.Posts {
					<div class="glass-panel p-4" data-admin-blog-id={ strconv.FormatInt(p.ID, 10) }>
						<div class="flex items-start justify-between gap-4">
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2 mb-1 flex-wrap">
									{{ label, tone := adminBlogStatusLabel(p.Status) }}
									<span class={ "inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border " + tone }>{ label }</span>
									<span class="text-[10px] text-gray-600">{ "#" + strconv.FormatInt(p.ID, 10) }</span>
									<span class="text-[10px] text-gray-500 font-mono break-all">{ "/blog/" + p.Slug }</span>
								</div>
								<div class="text-sm font-medium text-white break-words">{ p.Title }</div>
								if p.Excerpt != nil && *p.Excerpt != "" {
									<div class="text-xs text-gray-500 mt-1 line-clamp-2 break-words">{ *p.Excerpt }</div>
								}
								if len(p.Tags) > 0 {
									<div class="flex items-center gap-1 mt-2 flex-wrap">
										for _,tag := range p.Tags {
											@adminBlogTag(tag)
										}
									</div>
								}
								<div class="flex items-center gap-3 mt-2 text-[10px] text-gray-600 flex-wrap">
									<span>{ "By " + p.AuthorName }</span>
									if p.PublishedAt != nil {
										<span>{ "Published: " + adminBlogDate(*p.PublishedAt) }</span>
									}
									<span>{ "Updated: " + adminBlogDate(p.UpdatedAt) }</span>
								</div>
							</div>
							<div class="flex items-center gap-1 flex-shrink-0">
								<a href={ templ.SafeURL("/blog/preview/" + url.PathEscape(p.Slug)) } target="_blank" rel="noopener" aria-label={ "Preview post " + strconv.FormatInt(p.ID, 10) } title="Preview (admin-only)" class="flex items-center justify-center w-7 h-7 rounded-md text-gray-500 hover:text-yellow-400 hover:bg-yellow-500/[0.08] transition-colors cursor-pointer">
									<span class="text-sm">
										@icon("eye")
									</span>
								</a>
								if p.Status == 1 {
									<a href={ templ.SafeURL(blogPostURL(p.Slug)) } target="_blank" rel="noopener" aria-label={ "View live post " + strconv.FormatInt(p.ID, 10) } title="View live" class="flex items-center justify-center w-7 h-7 rounded-md text-gray-500 hover:text-blue-400 hover:bg-blue-500/[0.08] transition-colors cursor-pointer">
										<span class="text-sm">
											@icon("external-link")
										</span>
									</a>
								}
								<button type="button" data-admin-blog-edit aria-label={ "Edit post " + strconv.FormatInt(p.ID, 10) } title="Edit" class="flex items-center justify-center w-7 h-7 rounded-md text-gray-500 hover:text-blue-400 hover:bg-blue-500/[0.08] transition-colors cursor-pointer">
									<span class="text-sm">
										@icon("pencil")
									</span>
								</button>
								<button type="button" data-admin-blog-delete aria-label={ "Delete post " + strconv.FormatInt(p.ID, 10) } title="Delete" class="flex items-center justify-center h-7 rounded-md transition-colors cursor-pointer w-7 text-gray-500 hover:text-red-400 hover:bg-red-500/[0.08]">
									<span class="text-sm">
										@icon("trash-2")
									</span><span hidden data-admin-blog-confirm class="text-fine font-medium">Confirm</span>
								</button>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ adminBlogTag(tag string) {
	<span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-blue-500/10 text-blue-300 border border-blue-500/20 max-w-full break-all">{ "#" + tag }</span>
}

templ adminBlogForm() {
	<div class="space-y-4" data-admin-blog-form>
		@adminBlogInput("title", "Title *", "Post title", false)
		<div><label for="admin-blog-slug" class="block text-xs font-medium text-gray-400 mb-1">Slug <span class="text-gray-600">(optional — auto-generated from title)</span></label><input id="admin-blog-slug" name="slug" type="text" class="w-full bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white px-3 py-2 focus:outline-none focus:border-blue-500/50 font-mono" placeholder="my-post-slug"/></div>
		<div><label for="admin-blog-excerpt" class="block text-xs font-medium text-gray-400 mb-1">Excerpt (optional, 500 chars max)</label><textarea id="admin-blog-excerpt" name="excerpt" rows="2" maxlength="500" class="w-full bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white px-3 py-2 focus:outline-none focus:border-blue-500/50 resize-y" placeholder="Short summary shown on post cards"></textarea></div>
		@adminBlogInput("cover_image_url", "Cover image URL (optional)", "https://...", false)
		<div><label for="admin-blog-tags" class="block text-xs font-medium text-gray-400 mb-1">Tags <span class="text-gray-600">(comma-separated, lowercase, max 10)</span></label><input id="admin-blog-tags" name="tags" type="text" class="w-full bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white px-3 py-2 focus:outline-none focus:border-blue-500/50" placeholder="patch-notes, meta, pvp"/><div hidden data-admin-blog-tag-preview class="flex items-center gap-1 mt-2 flex-wrap"></div></div>
		<div><label for="admin-blog-body" class="block text-xs font-medium text-gray-400 mb-1">Body (markdown)</label><textarea id="admin-blog-body" name="body_md" rows="16" class="w-full bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white px-3 py-2 focus:outline-none focus:border-blue-500/50 resize-y font-mono" placeholder={ "# Heading\n\nPost content in markdown..." }></textarea></div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
			<div>
				<label class="block text-xs font-medium text-gray-400 mb-1">Status</label>
				<div class="flex gap-2">
					for value, label := range []string{"Draft", "Published", "Archived"} {
						<button type="button" data-admin-blog-status={ strconv.Itoa(value) } class="flex-1 px-3 py-2 rounded-lg text-xs font-medium border transition-colors cursor-pointer">{ label }</button>
					}
				</div>
			</div>
			<div>
				<label class="block text-xs font-medium text-gray-400 mb-1">Publish date <span class="text-gray-600">(optional, EVE time)</span></label>
				@dateTimePicker(dateTimePickerOptions{Name: "published_at", Placeholder: "Publish immediately"})
			</div>
		</div>
	</div>
}

templ adminBlogInput(name, label, placeholder string, mono bool) {
	<div><label for={ "admin-blog-" + name } class="block text-xs font-medium text-gray-400 mb-1">{ label }</label><input id={ "admin-blog-" + name } name={ name } type="text" class={ "w-full bg-white/[0.04] border border-white/[0.08] rounded-lg text-sm text-white px-3 py-2 focus:outline-none focus:border-blue-500/50 " + killBoolClass(mono, "font-mono", "") } placeholder={ placeholder }/></div>
}

templ adminBlogFooter() {
	<div class="flex items-center justify-end gap-3">
		<p hidden data-admin-blog-form-error role="alert" class="flex-1 text-xs text-red-400 flex items-center gap-1.5">
			<span class="text-sm flex-shrink-0">
				@icon("circle-alert")
			</span><span data-admin-blog-form-message></span>
		</p>
		<button type="button" data-admin-modal-close class="px-4 py-2 rounded-lg text-sm text-gray-400 hover:text-white transition-colors cursor-pointer">Cancel</button>
		<button type="button" data-admin-blog-save class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
			<span hidden data-admin-blog-spinner class="text-sm animate-spin mr-1 inline">
				@icon("loader-circle")
			</span><span data-admin-blog-save-label>Create</span>
		</button>
	</div>
}
